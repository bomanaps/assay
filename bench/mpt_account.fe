pub struct TrieKey { word: u256, key_nibbles: usize }

impl Copy for TrieKey {}
impl Snapshot for TrieKey {}

impl Eq for TrieKey {
    const fn eq(self, _ other: Self) -> bool {
        self.word == other.word && self.key_nibbles == other.key_nibbles
    }
}

impl TrieKey {
    pub const fn new(_ value: u256) -> Self {
        TrieKey { word: value, key_nibbles: 64 }
    }

    pub fn short(_ word: u256, _ nibbles: usize) -> Self {
        core::assert(nibbles > 0)
        core::assert(nibbles <= 64)
        core::assert(nibbles % 2 == 0)
        if nibbles < 64 {
            core::assert(word << (4 * nibbles as u256) == 0)
        }
        TrieKey { word, key_nibbles: nibbles }
    }

    pub const fn value(self) -> u256 {
        self.word
    }

    pub const fn nibbles(self) -> usize {
        self.key_nibbles
    }
}

pub struct AccountState {
    pub nonce: u64,
    pub balance: u256,
    pub storage_root: StorageRoot,
    pub code_hash: CodeHash,
}

impl Copy for AccountState {}

impl Eq for AccountState {
    const fn eq(self, _ other: Self) -> bool {
        self.nonce == other.nonce
            && self.balance == other.balance
            && self.storage_root == other.storage_root
            && self.code_hash == other.code_hash
    }
}

impl Default for AccountState {
    fn default() -> Self {
        AccountState::missing()
    }
}

impl AccountState {
    pub const fn missing() -> Self {
        AccountState {
            nonce: 0,
            balance: 0,
            storage_root: StorageRoot::empty(),
            code_hash: CodeHash::empty(),
        }
    }

    pub const fn is_empty(self) -> bool {
        self.nonce == 0 && self.balance == 0 && self.code_hash == CodeHash::empty()
    }
}

pub enum Proven<T> {
    Present(T),
    Absent,
}

impl<T> Copy for Proven<T> where T: Copy {}

impl<T: Eq> Eq for Proven<T> {
    fn eq(self, _ other: Self) -> bool {
        match self {
            Self::Present(ref value) => match other {
                Proven::Present(ref other_value) => value == other_value,
                Proven::Absent => false,
            },
            Self::Absent => other.is_absent(),
        }
    }
}

impl<T> Proven<T> {
    pub fn is_present(self) -> bool {
        match self {
            Self::Present(_) => true,
            Self::Absent => false,
        }
    }

    pub fn is_absent(self) -> bool {
        !self.is_present()
    }
}

pub enum ProofError {
    BadRlp,
    HashMismatch(usize),
    PathExhausted,
    TrailingNodes,
    BadHexPrefix,
    BranchValueOnPath,
    DepthOutOfRange,
    RootMismatch,
    KeyNotConsumed,
    IndexOutOfRange,
    WrongLength,
}

impl Copy for ProofError {}

impl Eq for ProofError {
    fn eq(self, _ other: Self) -> bool {
        match (self, other) {
            (Self::BadRlp, Self::BadRlp) => true,
            (Self::HashMismatch(depth), Self::HashMismatch(other_depth)) => depth == other_depth,
            (Self::PathExhausted, Self::PathExhausted) => true,
            (Self::TrailingNodes, Self::TrailingNodes) => true,
            (Self::BadHexPrefix, Self::BadHexPrefix) => true,
            (Self::BranchValueOnPath, Self::BranchValueOnPath) => true,
            (Self::DepthOutOfRange, Self::DepthOutOfRange) => true,
            (Self::RootMismatch, Self::RootMismatch) => true,
            (Self::KeyNotConsumed, Self::KeyNotConsumed) => true,
            (Self::IndexOutOfRange, Self::IndexOutOfRange) => true,
            (Self::WrongLength, Self::WrongLength) => true,
            _ => false,
        }
    }
}

pub const KEY_NIBBLES: usize = 64
pub const FLAG_ODD: usize = 1
pub const FLAG_LEAF: usize = 2

pub fn key_nibble(_ key: u256, _ index: usize) -> usize {
    core::assert(index < KEY_NIBBLES)
    ((key >> ((252 - 4 * index) as u256)) & 0xf).downcast_truncate()
}

pub struct HexPath { pub is_leaf: bool, pub skip: usize, pub len: usize }

impl Copy for HexPath {}

pub fn decode_hex_prefix(_ encoded: MemSpan) -> Result<ProofError, HexPath> {
    if encoded.len() == 0 {
        return Result::Err(ProofError::BadHexPrefix)
    }
    let first = encoded.byte_at(0) as usize
    let flag = first >> 4
    if flag > FLAG_LEAF + FLAG_ODD {
        return Result::Err(ProofError::BadHexPrefix)
    }
    let is_leaf = flag & FLAG_LEAF != 0
    if flag & FLAG_ODD != 0 {
        return Result::Ok(HexPath { is_leaf, skip: 1, len: 2 * encoded.len() - 1 })
    }
    if first & 0xf != 0 {
        return Result::Err(ProofError::BadHexPrefix)
    }
    Result::Ok(HexPath { is_leaf, skip: 2, len: 2 * encoded.len() - 2 })
}

pub fn path_nibble(_ path: HexPath, _ encoded: MemSpan, _ index: usize) -> usize {
    core::assert(index < path.len)
    let position = path.skip + index
    let byte = encoded.byte_at(position / 2) as usize
    if position % 2 == 0 {
        byte >> 4
    } else {
        byte & 0xf
    }
}

pub const BRANCH_ITEMS: usize = 17
pub const BRANCH_VALUE: usize = 16
pub const PAIR_ITEMS: usize = 2
pub const HASH_LEN: usize = 32
pub const MAX_INLINE_PAYLOAD: usize = 30

pub trait ProofNodes {
    fn count(self) -> usize
    fn node(self, _ index: usize) -> ref MemSpan
}

pub struct NodeList { bytes: MemBuffer, offsets: MemVec<usize> }

impl NodeList {
    pub fn new() -> Self {
        var offsets = MemVec::new()
        offsets.push(0)
        NodeList { bytes: MemBuffer::empty(), offsets }
    }

    pub fn from_fixture<const N: usize, const M: usize>(
        _ bytes: [u8; N],
        _ offsets: [usize; M],
        first: usize,
        count: usize,
    ) -> Self {
        var list = NodeList::new()
        var i = first
        while i < first + count {
            var node = MemBuffer::new(offsets[i + 1] - offsets[i])
            var j: usize = 0
            while j < node.len() {
                node[j] = bytes[offsets[i] + j]
                j += 1
            }
            list.push(node.span())
            i += 1
        }
        list
    }

    pub fn push(mut self, _ node: MemSpan) {
        var i: usize = 0
        while i < node.len() {
            self.bytes.push(node.byte_at(i))
            i += 1
        }
        self.offsets.push(self.bytes.len())
    }

    pub fn drop_last(mut self) {
        core::assert(self.count() > 0)
        let start = self.offsets[self.count() - 1]
        self.offsets.pop()
        self.bytes.truncate(start)
    }

    pub fn duplicate_last(mut self) {
        core::assert(self.count() > 0)
        let start = self.offsets[self.count() - 1]
        let len = self.bytes.len() - start
        var copy = MemBuffer::new(len)
        var i: usize = 0
        while i < len {
            copy[i] = self.bytes[start + i]
            i += 1
        }
        self.push(copy.span())
    }

    pub fn flip_byte(mut self, node: usize, at: usize) {
        let start = self.offsets[node]
        core::assert(start + at < self.offsets[node + 1])
        self.bytes[start + at] = self.bytes[start + at] ^ 0x01
    }
}

impl ProofNodes for NodeList {
    fn count(self) -> usize {
        self.offsets.len() - 1
    }

    fn node(self, _ index: usize) -> ref MemSpan {
        let start = self.offsets[index]
        self.bytes.span().slice(offset: start, len: self.offsets[index + 1] - start)
    }
}

impl ProofNodes for MemArray<Bytes> {
    fn count(self) -> usize {
        self.len()
    }

    fn node(self, _ index: usize) -> ref MemSpan {
        self[index].span()
    }
}

pub struct Leaf { pub node: usize, pub item: Item }

impl Copy for Leaf {}

pub fn verify_trie<P: ProofNodes>(root: Root, key: TrieKey, nodes: P) -> Result<
    ProofError,
    Proven<Leaf>,
> {
    var expected = root.value()
    var position: usize = 0
    var depth: usize = 0
    var node_index: usize = 0
    var current: Option<Item> = Option::None
    while true {
        let item = match current {
            Option::Some(item) => item,
            Option::None => {
                if depth >= nodes.count() {
                    return Result::Err(ProofError::PathExhausted)
                }
                node_index = depth
                depth += 1
                let span = nodes.node(node_index)
                if keccak256(span) != expected {
                    return Result::Err(ProofError::HashMismatch(node_index))
                }
                if node_index > 0 && span.len() < HASH_LEN {
                    return Result::Err(ProofError::BadRlp)
                }
                match rlp::decode(span) {
                    Option::Some(item) => item,
                    Option::None => {
                        return Result::Err(ProofError::BadRlp)
                    },
                }
            },
        }
        let span = nodes.node(node_index)
        let items = match item.items(span) {
            Option::Some(items) => items,
            Option::None => {
                return Result::Err(ProofError::BadRlp)
            },
        }
        let remaining = depth < nodes.count()
        var child = item
        var from_extension = false
        if items.len() == BRANCH_ITEMS {
            if position == key.nibbles() {
                if remaining {
                    return Result::Err(ProofError::TrailingNodes)
                }
                let value = items[BRANCH_VALUE]
                if value.is_list() {
                    return Result::Err(ProofError::BadRlp)
                }
                if value.payload(span).len() == 0 {
                    return Result::Ok(Proven::Absent)
                }
                return Result::Ok(Proven::Present(Leaf { node: node_index, item: value }))
            }
            if items[BRANCH_VALUE].is_list() || items[BRANCH_VALUE].payload(span).len() != 0 {
                return Result::Err(ProofError::BranchValueOnPath)
            }
            child = items[key_nibble(key.value(), position)]
            position += 1
        } else if items.len() == PAIR_ITEMS {
            if items[0].is_list() {
                return Result::Err(ProofError::BadRlp)
            }
            let encoded = items[0].payload(span)
            let path = decode_hex_prefix(encoded)?
            if !path.is_leaf && path.len == 0 {
                return Result::Err(ProofError::BadRlp)
            }
            if position + path.len > key.nibbles() {
                return Result::Err(ProofError::BadRlp)
            }
            var matches = true
            var i: usize = 0
            while matches && i < path.len {
                if path_nibble(path, encoded, i) != key_nibble(key.value(), position + i) {
                    matches = false
                }
                i += 1
            }
            if !matches {
                if remaining {
                    return Result::Err(ProofError::TrailingNodes)
                }
                return Result::Ok(Proven::Absent)
            }
            position += path.len
            if path.is_leaf {
                if position != key.nibbles() {
                    return Result::Err(ProofError::KeyNotConsumed)
                }
                if remaining {
                    return Result::Err(ProofError::TrailingNodes)
                }
                if items[1].is_list() {
                    return Result::Err(ProofError::BadRlp)
                }
                return Result::Ok(Proven::Present(Leaf { node: node_index, item: items[1] }))
            }
            child = items[1]
            from_extension = true
        } else {
            return Result::Err(ProofError::BadRlp)
        }
        if child.is_list() {
            if child.payload(span).len() > MAX_INLINE_PAYLOAD {
                return Result::Err(ProofError::BadRlp)
            }
            current = Option::Some(child)
            continue
        }
        let reference = child.payload(span)
        if reference.len() == 0 {
            if from_extension {
                return Result::Err(ProofError::BadRlp)
            }
            if remaining {
                return Result::Err(ProofError::TrailingNodes)
            }
            return Result::Ok(Proven::Absent)
        }
        if reference.len() != HASH_LEN {
            return Result::Err(ProofError::BadRlp)
        }
        expected = reference.read_word(0)
        current = Option::None
    }
    Result::Err(ProofError::PathExhausted)
}

pub const ACCOUNT_FIELDS: usize = 4
pub const ADDRESS_LEN: usize = 20

pub fn account_key(_ address: [u8; 20]) -> TrieKey {
    let buffer = address_span(address)
    TrieKey::new(keccak256(buffer.span()))
}

fn address_span(_ address: [u8; 20]) -> MemBuffer {
    var buffer = MemBuffer::new(ADDRESS_LEN)
    var i: usize = 0
    while i < ADDRESS_LEN {
        buffer[i] = address[i]
        i += 1
    }
    buffer
}

pub fn decode_account(_ encoded: MemSpan) -> Result<ProofError, AccountState> {
    let item = match rlp::decode(encoded) {
        Option::Some(item) => item,
        Option::None => {
            return Result::Err(ProofError::BadRlp)
        },
    }
    let fields = match item.items(encoded) {
        Option::Some(fields) => fields,
        Option::None => {
            return Result::Err(ProofError::BadRlp)
        },
    }
    if fields.len() != ACCOUNT_FIELDS {
        return Result::Err(ProofError::BadRlp)
    }
    let nonce = match fields[0].as_uint(encoded) {
        Option::Some(nonce) => nonce,
        Option::None => {
            return Result::Err(ProofError::BadRlp)
        },
    }
    let balance = match fields[1].as_uint(encoded) {
        Option::Some(balance) => balance,
        Option::None => {
            return Result::Err(ProofError::BadRlp)
        },
    }
    let storage_root = word_field(fields[2], encoded)?
    let code_hash = word_field(fields[3], encoded)?
    let nonce64: u64 = match nonce.downcast() {
        Option::Some(nonce64) => nonce64,
        Option::None => {
            return Result::Err(ProofError::BadRlp)
        },
    }
    Result::Ok(
        AccountState {
            nonce: nonce64,
            balance,
            storage_root: StorageRoot::new(storage_root),
            code_hash: CodeHash::new(code_hash),
        },
    )
}

fn word_field(_ item: Item, _ encoded: MemSpan) -> Result<ProofError, u256> {
    if item.is_list() {
        return Result::Err(ProofError::BadRlp)
    }
    let bytes = item.payload(encoded)
    if bytes.len() != HASH_LEN {
        return Result::Err(ProofError::BadRlp)
    }
    Result::Ok(bytes.read_word(0))
}

pub fn verify_account<P: ProofNodes>(
    state_root: StateRoot,
    _ address: [u8; 20],
    nodes: P,
) -> Result<ProofError, Proven<AccountState>> {
    match verify_trie(
        root: state_root.as_root(),
        key: account_key(address),
        nodes,
    )? {
        Proven::Present(leaf) => {
            let account = decode_account(leaf.item.payload(nodes.node(leaf.node)))?
            Result::Ok(Proven::Present(account))
        },
        Proven::Absent => Result::Ok(Proven::Absent),
    }
}

pub fn storage_key(_ slot: u256) -> TrieKey {
    var buffer = MemBuffer::new(HASH_LEN)
    buffer.write_word(offset: 0, value: slot)
    TrieKey::new(keccak256(buffer.span()))
}

pub fn decode_storage_value(_ encoded: MemSpan) -> Result<ProofError, u256> {
    let item = match rlp::decode(encoded) {
        Option::Some(item) => item,
        Option::None => {
            return Result::Err(ProofError::BadRlp)
        },
    }
    match item.as_uint(encoded) {
        Option::Some(0) => Result::Err(ProofError::BadRlp),
        Option::Some(value) => Result::Ok(value),
        Option::None => Result::Err(ProofError::BadRlp),
    }
}

pub fn verify_storage<P: ProofNodes>(storage_root: StorageRoot, slot: u256, nodes: P) -> Result<
    ProofError,
    u256,
> {
    if storage_root.value() == EMPTY_STORAGE_ROOT {
        if nodes.count() != 0 {
            return Result::Err(ProofError::TrailingNodes)
        }
        return Result::Ok(0)
    }
    match verify_trie(
        root: storage_root.as_root(),
        key: storage_key(slot),
        nodes,
    )? {
        Proven::Present(leaf) => decode_storage_value(leaf.item.payload(nodes.node(leaf.node))),
        Proven::Absent => Result::Ok(0),
    }
}

pub fn load<const N: usize>(_ bytes: [u8; N]) -> MemBuffer {
    var buffer = MemBuffer::with_capacity(N)
    var i: usize = 0
    while i < N {
        buffer.push(bytes[i])
        i += 1
    }
    buffer
}

pub fn load_packed<const N: usize>(_ words: [u256; N], len: usize) -> MemBuffer {
    core::assert(len <= 32 * N && 32 * N < len + 32)
    var buffer = MemBuffer::new(32 * N)
    var i: usize = 0
    while i < N {
        buffer.write_word(offset: 32 * i, value: words[i])
        i += 1
    }
    buffer.truncate(len)
    buffer
}

