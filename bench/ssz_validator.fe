    0x2c5f0e77ff4109cccbf29695da82d4d2a606554fa76ad530eb8f7b30ea63691c,
    0x1b420fac31bde29f9ca09ca9ff1046363c71d603d5c77c75aa88e2af91ccfedb,
    0x5527e9b78521c1ea742a5efc2dc77fd06fddad9bd81564bd3bbb2b3e7506ed8e,
    0xd8ea29d967a379240ccdc25c3f6e5ec638a5d5a58d54aeb05204fbd8227bf26b,
    0x1bec672660b586883283a1ae70435c7ff3f90391186dd8e5769459f36c1f4fe3,
    0x26eec1bbfa33400a3eae1bbaae40458e6312df6c90b568c77fcf690933c703e5,
    0x548ae1cd500328193bca25d1102eb9580320c6cb4eed7c03706679aa5d8d9d1f,
    0xba9612e7413c103a4ec477f11d8c3666614f5ebef678da44b41cc553e32f8af1,
]
const BENCH_DEPTH: usize = 50
const BENCH_PUBKEY_WORDS: [u256; 2] = [
    0x821a1c6d2115d652dd98aa6d8ffd01311778c73dc8a8087d2b97e3e3f314b127,
    0x6af64eeb6513c249cccc21f3833b246900000000000000000000000000000000,
]
const BENCH_INDEX: u64 = 2345678
const BENCH_CREDENTIALS: u256 = 0x010000000000000000000000834beedcdb85bc51bff59c0b6a8c2414aa0818cc
const BENCH_EFFECTIVE_BALANCE: u64 = 32000000000
const BENCH_SLASHED: bool = false
const BENCH_ACTIVATION_ELIGIBILITY_EPOCH: u64 = 470673
const BENCH_ACTIVATION_EPOCH: u64 = 470679
const BENCH_EXIT_EPOCH: u64 = 18446744073709551615
const BENCH_WITHDRAWABLE_EPOCH: u64 = 18446744073709551615

pub msg BenchMsg {
    #[selector = sol("verify()")]
    Verify -> u256,
    #[selector = sol("baseline()")]
    Baseline -> u256,
}

pub contract AssayBench {
    recv BenchMsg {
        Verify -> u256 {
            let pubkey = load_packed(BENCH_PUBKEY_WORDS, len: 48)
            let pubkey_root = match bytes48_leaf(pubkey.span()) {
                Result::Ok(root) => root,
                Result::Err(_) => core::panic_code(1),
            }
            let record = Validator {
                pubkey_root,
                withdrawal_credentials: BENCH_CREDENTIALS,
                effective_balance: BENCH_EFFECTIVE_BALANCE,
                slashed: BENCH_SLASHED,
                activation_eligibility_epoch: BENCH_ACTIVATION_ELIGIBILITY_EPOCH,
                activation_epoch: BENCH_ACTIVATION_EPOCH,
                exit_epoch: BENCH_EXIT_EPOCH,
                withdrawable_epoch: BENCH_WITHDRAWABLE_EPOCH,
            }
            let branch: Branch<BENCH_DEPTH> = Branch::new(BENCH_BRANCH)
            match verify_validator(
                beacon_root: BeaconRoot::new(BENCH_ROOT),
                index: BENCH_INDEX,
                validator: record,
                branch,
            ) {
                Result::Ok(()) => 1,
                Result::Err(_) => core::panic_code(1),
            }
        }

        Baseline -> u256 {
            let pubkey = load_packed(BENCH_PUBKEY_WORDS, len: 48)
            let pubkey_root = match bytes48_leaf(pubkey.span()) {
                Result::Ok(root) => root,
                Result::Err(_) => core::panic_code(1),
            }
            let record = Validator {
                pubkey_root,
                withdrawal_credentials: BENCH_CREDENTIALS,
                effective_balance: BENCH_EFFECTIVE_BALANCE,
                slashed: BENCH_SLASHED,
                activation_eligibility_epoch: BENCH_ACTIVATION_ELIGIBILITY_EPOCH,
                activation_epoch: BENCH_ACTIVATION_EPOCH,
                exit_epoch: BENCH_EXIT_EPOCH,
                withdrawable_epoch: BENCH_WITHDRAWABLE_EPOCH,
            }
            let branch: Branch<BENCH_DEPTH> = Branch::new(BENCH_BRANCH)
            record.root() ^ BENCH_GINDEX ^ branch.nodes().len() as u256
        }

    }
}
