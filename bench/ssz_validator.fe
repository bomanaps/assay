pub struct AccountState {
    pub nonce: u64,
    pub balance: u256,
    pub storage_root: StorageRoot,
    pub code_hash: CodeHash,
}

impl Copy for AccountState {}

impl Eq for AccountState {
    const fn eq(self, _ other: Self) -> bool {
        self.nonce == other.nonce
            && self.balance == other.balance
            && self.storage_root == other.storage_root
            && self.code_hash == other.code_hash
    }
}

impl Default for AccountState {
    fn default() -> Self {
        AccountState::missing()
    }
}

impl AccountState {
    pub const fn missing() -> Self {
        AccountState {
            nonce: 0,
            balance: 0,
            storage_root: StorageRoot::empty(),
            code_hash: CodeHash::empty(),
        }
    }

    pub const fn is_empty(self) -> bool {
        self.nonce == 0 && self.balance == 0 && self.code_hash == CodeHash::empty()
    }
}

pub enum Proven<T> {
    Present(T),
    Absent,
}

impl<T> Copy for Proven<T> where T: Copy {}

impl<T: Eq> Eq for Proven<T> {
    fn eq(self, _ other: Self) -> bool {
        match self {
            Self::Present(ref value) => match other {
                Proven::Present(ref other_value) => value == other_value,
                Proven::Absent => false,
            },
            Self::Absent => other.is_absent(),
        }
    }
}

impl<T> Proven<T> {
    pub fn is_present(self) -> bool {
        match self {
            Self::Present(_) => true,
            Self::Absent => false,
        }
    }

    pub fn is_absent(self) -> bool {
        !self.is_present()
    }
}

pub enum ProofError {
    BadRlp,
    HashMismatch(usize),
    PathExhausted,
    TrailingNodes,
    BadHexPrefix,
    BranchValueOnPath,
    DepthOutOfRange,
    RootMismatch,
    KeyNotConsumed,
    IndexOutOfRange,
    WrongLength,
}

impl Copy for ProofError {}

impl Eq for ProofError {
    fn eq(self, _ other: Self) -> bool {
        match (self, other) {
            (Self::BadRlp, Self::BadRlp) => true,
            (Self::HashMismatch(depth), Self::HashMismatch(other_depth)) => depth == other_depth,
            (Self::PathExhausted, Self::PathExhausted) => true,
            (Self::TrailingNodes, Self::TrailingNodes) => true,
            (Self::BadHexPrefix, Self::BadHexPrefix) => true,
            (Self::BranchValueOnPath, Self::BranchValueOnPath) => true,
            (Self::DepthOutOfRange, Self::DepthOutOfRange) => true,
            (Self::RootMismatch, Self::RootMismatch) => true,
            (Self::KeyNotConsumed, Self::KeyNotConsumed) => true,
            (Self::IndexOutOfRange, Self::IndexOutOfRange) => true,
            (Self::WrongLength, Self::WrongLength) => true,
            _ => false,
        }
    }
}

pub const MAX_BRANCH_DEPTH: usize = 64

pub const fn bit_length(_ value: u256) -> u256 {
    var length: u256 = 0
    var rest = value
    while rest > 0 {
        rest >>= 1
        length += 1
    }
    length
}

pub const fn depth_for(_ fields: u256) -> u256 {
    var depth: u256 = 0
    while (1 << depth) < fields {
        depth += 1
    }
    depth
}

pub const fn field(_ fields: u256, _ index: u256) -> u256 {
    if index >= fields {
        core::panic_code(PANIC_ASSERT)
    }
    (1 << depth_for(fields)) + index
}

pub const fn concat(_ outer: u256, _ inner: u256) -> u256 {
    if outer == 0 || inner == 0 {
        core::panic_code(PANIC_ASSERT)
    }
    let shift = bit_length(inner) - 1
    (outer << shift) | (inner - (1 << shift))
}

pub fn software_hash_pair(_ left: u256, _ right: u256) -> u256 {
    var buffer = MemBuffer::new(64)
    buffer.write_word(offset: 0, value: left)
    buffer.write_word(offset: 32, value: right)
    sha256_word(buffer.span())
}

#[cfg(target = "evm")]
pub fn hash_pair(_ left: u256, _ right: u256) -> u256 {
    std::evm::ssz::hash_pair(left: left, right: right)
}

#[cfg(target = "native")]
pub fn hash_pair(_ left: u256, _ right: u256) -> u256 {
    software_hash_pair(left, right)
}

#[cfg(target = "evm")]
pub fn bytes48_leaf(_ bytes: MemSpan) -> Result<ProofError, u256> {
    if bytes.len() != 48 {
        return Result::Err(ProofError::WrongLength)
    }
    Result::Ok(
        std::evm::ssz::hash_tree_root<std::evm::ssz::ByteVector<48>>(bytes, start: 0, len: 48),
    )
}

#[cfg(target = "native")]
pub fn bytes48_leaf(_ bytes: MemSpan) -> Result<ProofError, u256> {
    if bytes.len() != 48 {
        return Result::Err(ProofError::WrongLength)
    }
    var buffer = MemBuffer::new(64)
    buffer.copy_from(dest_offset: 0, bytes)
    Result::Ok(
        software_hash_pair(buffer.read_word(0), buffer.read_word(32)),
    )
}

pub struct Branch<const DEPTH: usize> where DEPTH >= 1, DEPTH <= MAX_BRANCH_DEPTH {
    nodes: MemVec<u256>,
}

impl<const DEPTH: usize> Branch<DEPTH> {
    pub fn new(_ nodes: [u256; DEPTH]) -> Self {
        var words = MemVec::with_capacity(DEPTH)
        var i: usize = 0
        while i < DEPTH {
            words.push(nodes[i])
            i += 1
        }
        Branch { nodes: words }
    }
}

impl<const DEPTH: usize> ProofNodes for Branch<DEPTH> {
    fn nodes(self) -> ref MemSlice<u256> {
        self.nodes.as_slice()
    }
}

pub fn verify_branch<P: ProofNodes>(root: Root, leaf: u256, gindex: GIndex, branch: P) -> Result<
    ProofError,
    (),
> {
    let position = gindex.value()
    if position == 0 {
        return Result::Err(ProofError::DepthOutOfRange)
    }
    let nodes = branch.nodes()
    if bit_length(position) - 1 != nodes.len() as u256 {
        return Result::Err(ProofError::DepthOutOfRange)
    }
    var node = leaf
    var level: usize = 0
    while level < nodes.len() {
        if (position >> (level as u256)) & 1 == 1 {
            node = hash_pair(nodes[level], node)
        } else {
            node = hash_pair(node, nodes[level])
        }
        level += 1
    }
    if node != root.value() {
        return Result::Err(ProofError::RootMismatch)
    }
    Result::Ok(())
}

pub const HEADER_FIELDS: u256 = 5
pub const BODY_FIELDS: u256 = 13
pub const PAYLOAD_FIELDS: u256 = 17
pub const STATE_FIELDS: u256 = 38
pub const FORK_FIELDS: u256 = 3
pub const VALIDATOR_FIELDS: u256 = 8
pub const VALIDATOR_REGISTRY_DEPTH: u256 = 40
pub const VALIDATOR_REGISTRY_LIMIT: u256 = 1 << VALIDATOR_REGISTRY_DEPTH

pub const HEADER_STATE_ROOT: u256 = field(HEADER_FIELDS, 3)
pub const HEADER_BODY_ROOT: u256 = field(HEADER_FIELDS, 4)
pub const EXECUTION_PAYLOAD: u256 = concat(HEADER_BODY_ROOT, field(BODY_FIELDS, 9))
pub const PAYLOAD_STATE_ROOT: u256 = concat(EXECUTION_PAYLOAD, field(PAYLOAD_FIELDS, 2))
pub const PAYLOAD_BLOCK_NUMBER: u256 = concat(EXECUTION_PAYLOAD, field(PAYLOAD_FIELDS, 6))
pub const PAYLOAD_BLOCK_HASH: u256 = concat(EXECUTION_PAYLOAD, field(PAYLOAD_FIELDS, 12))
pub const STATE_GENESIS_VALIDATORS_ROOT: u256 = concat(HEADER_STATE_ROOT, field(STATE_FIELDS, 1))
pub const STATE_FORK_CURRENT_VERSION: u256 = concat(
    HEADER_STATE_ROOT,
    concat(field(STATE_FIELDS, 3), field(FORK_FIELDS, 1)),
)
pub const VALIDATORS_DATA: u256 = concat(HEADER_STATE_ROOT, concat(field(STATE_FIELDS, 11), 2))

static_assert(HEADER_STATE_ROOT == 11)
static_assert(HEADER_BODY_ROOT == 12)
static_assert(PAYLOAD_STATE_ROOT == 6434)
static_assert(PAYLOAD_BLOCK_NUMBER == 6438)
static_assert(PAYLOAD_BLOCK_HASH == 6444)
static_assert(STATE_GENESIS_VALIDATORS_ROOT == 705)
static_assert(STATE_FORK_CURRENT_VERSION == 2829)

pub enum PayloadField {
    StateRoot,
    BlockNumber,
    BlockHash,
}

impl PayloadField {
    pub const fn gindex(self) -> GIndex {
        GIndex::new(
            match self {
                Self::StateRoot => PAYLOAD_STATE_ROOT,
                Self::BlockNumber => PAYLOAD_BLOCK_NUMBER,
                Self::BlockHash => PAYLOAD_BLOCK_HASH,
            },
        )
    }
}

pub enum StateField {
    GenesisValidatorsRoot,
    ForkCurrentVersion,
}

impl StateField {
    pub const fn gindex(self) -> GIndex {
        GIndex::new(
            match self {
                Self::GenesisValidatorsRoot => STATE_GENESIS_VALIDATORS_ROOT,
                Self::ForkCurrentVersion => STATE_FORK_CURRENT_VERSION,
            },
        )
    }
}

pub enum ValidatorField {
    Pubkey,
    WithdrawalCredentials,
    EffectiveBalance,
}

impl ValidatorField {
    pub const fn index(self) -> u256 {
        match self {
            Self::Pubkey => 0,
            Self::WithdrawalCredentials => 1,
            Self::EffectiveBalance => 2,
        }
    }
}

pub const fn validator_element_gindex(_ index: u64) -> GIndex {
    if index as u256 >= VALIDATOR_REGISTRY_LIMIT {
        core::panic_code(PANIC_ASSERT)
    }
    GIndex::new(
        concat(VALIDATORS_DATA, VALIDATOR_REGISTRY_LIMIT + index as u256),
    )
}

pub const fn validator_gindex(_ index: u64, _ which: ValidatorField) -> GIndex {
    GIndex::new(
        concat(
            validator_element_gindex(index).value(),
            field(VALIDATOR_FIELDS, which.index()),
        ),
    )
}

static_assert(validator_element_gindex(0).value() == 1572301627719680)
static_assert(validator_element_gindex(2345678).value() == 1572301630065358)
static_assert(validator_gindex(0, ValidatorField::Pubkey).value() == 12578413021757440)
static_assert(validator_gindex(0, ValidatorField::WithdrawalCredentials).value()
    == 12578413021757441)
static_assert(validator_gindex(2345678, ValidatorField::EffectiveBalance).value()
    == 12578413040522866)

pub struct BeaconBlockHeader {
    pub slot: u64,
    pub proposer_index: u64,
    pub parent_root: u256,
    pub state_root: u256,
    pub body_root: u256,
}

impl Copy for BeaconBlockHeader {}

impl BeaconBlockHeader {
    pub fn root(self) -> BeaconRoot {
        let left = hash_pair(
            hash_pair(u64_chunk(self.slot), u64_chunk(self.proposer_index)),
            hash_pair(self.parent_root, self.state_root),
        )
        let right = hash_pair(hash_pair(self.body_root, 0), hash_pair(0, 0))
        BeaconRoot::new(hash_pair(left, right))
    }
}

pub struct Validator {
    pub pubkey_root: u256,
    pub withdrawal_credentials: u256,
    pub effective_balance: u64,
    pub slashed: bool,
    pub activation_eligibility_epoch: u64,
    pub activation_epoch: u64,
    pub exit_epoch: u64,
    pub withdrawable_epoch: u64,
}

impl Copy for Validator {}

impl Validator {
    pub fn root(self) -> u256 {
        let slashed: u256 = if self.slashed { 1 << 248 } else { 0 }
        let left = hash_pair(
            hash_pair(self.pubkey_root, self.withdrawal_credentials),
            hash_pair(u64_chunk(self.effective_balance), slashed),
        )
        let right = hash_pair(
            hash_pair(
                u64_chunk(self.activation_eligibility_epoch),
                u64_chunk(self.activation_epoch),
            ),
            hash_pair(
                u64_chunk(self.exit_epoch),
                u64_chunk(self.withdrawable_epoch),
            ),
        )
        hash_pair(left, right)
    }
}

pub fn verify_payload_field<P: ProofNodes>(
    beacon_root: BeaconRoot,
    which: PayloadField,
    leaf: u256,
    branch: P,
) -> Result<ProofError, ()> {
    verify_branch(
        root: beacon_root.as_root(),
        leaf,
        gindex: which.gindex(),
        branch,
    )
}

pub fn verify_execution_state_root<P: ProofNodes>(
    beacon_root: BeaconRoot,
    state_root: u256,
    branch: P,
) -> Result<ProofError, StateRoot> {
    verify_payload_field(
        beacon_root,
        which: PayloadField::StateRoot,
        leaf: state_root,
        branch,
    )?
    Result::Ok(StateRoot::new(state_root))
}

pub fn verify_state_field<P: ProofNodes>(
    beacon_root: BeaconRoot,
    which: StateField,
    leaf: u256,
    branch: P,
) -> Result<ProofError, ()> {
    verify_branch(
        root: beacon_root.as_root(),
        leaf,
        gindex: which.gindex(),
        branch,
    )
}

pub fn verify_validator<P: ProofNodes>(
    beacon_root: BeaconRoot,
    index: u64,
    validator: Validator,
    branch: P,
) -> Result<ProofError, ()> {
    if index as u256 >= VALIDATOR_REGISTRY_LIMIT {
        return Result::Err(ProofError::IndexOutOfRange)
    }
    verify_branch(
        root: beacon_root.as_root(),
        leaf: validator.root(),
        gindex: validator_element_gindex(index),
        branch,
    )
}

pub fn verify_validator_field<P: ProofNodes>(
    beacon_root: BeaconRoot,
    index: u64,
    which: ValidatorField,
    leaf: u256,
    branch: P,
) -> Result<ProofError, ()> {
    if index as u256 >= VALIDATOR_REGISTRY_LIMIT {
        return Result::Err(ProofError::IndexOutOfRange)
    }
    verify_branch(
        root: beacon_root.as_root(),
        leaf,
        gindex: validator_gindex(index, which),
        branch,
    )
}

pub fn load<const N: usize>(_ bytes: [u8; N]) -> MemBuffer {
    var buffer = MemBuffer::with_capacity(N)
    var i: usize = 0
    while i < N {
        buffer.push(bytes[i])
        i += 1
    }
    buffer
}

pub fn load_packed<const N: usize>(_ words: [u256; N], len: usize) -> MemBuffer {
    core::assert(len <= 32 * N && 32 * N < len + 32)
    var buffer = MemBuffer::new(32 * N)
    var i: usize = 0
    while i < N {
        buffer.write_word(offset: 32 * i, value: words[i])
        i += 1
    }
    buffer.truncate(len)
    buffer
}

