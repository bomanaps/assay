use std::evm::merkle::ProofNodes
use std::evm::ssz::u64_chunk
use ingot::ssz::{concat, field, hash_pair, verify_branch}
use core::panics::PANIC_ASSERT
use ingot::{BeaconRoot, GIndex, ProofError, ReceiptsRoot, Root, StateRoot}

pub const HEADER_FIELDS: u256 = 5
pub const BODY_FIELDS: u256 = 13
pub const PAYLOAD_FIELDS: u256 = 17
pub const STATE_FIELDS: u256 = 38
pub const FORK_FIELDS: u256 = 3
pub const VALIDATOR_FIELDS: u256 = 8
pub const VALIDATOR_REGISTRY_DEPTH: u256 = 40
pub const VALIDATOR_REGISTRY_LIMIT: u256 = 1 << VALIDATOR_REGISTRY_DEPTH

pub const HEADER_STATE_ROOT: u256 = field(HEADER_FIELDS, 3)
pub const HEADER_BODY_ROOT: u256 = field(HEADER_FIELDS, 4)
pub const EXECUTION_PAYLOAD: u256 = concat(HEADER_BODY_ROOT, field(BODY_FIELDS, 9))
pub const PAYLOAD_STATE_ROOT: u256 = concat(EXECUTION_PAYLOAD, field(PAYLOAD_FIELDS, 2))
pub const PAYLOAD_RECEIPTS_ROOT: u256 = concat(EXECUTION_PAYLOAD, field(PAYLOAD_FIELDS, 3))
pub const PAYLOAD_BLOCK_NUMBER: u256 = concat(EXECUTION_PAYLOAD, field(PAYLOAD_FIELDS, 6))
pub const PAYLOAD_BLOCK_HASH: u256 = concat(EXECUTION_PAYLOAD, field(PAYLOAD_FIELDS, 12))
pub const STATE_GENESIS_VALIDATORS_ROOT: u256 = concat(HEADER_STATE_ROOT, field(STATE_FIELDS, 1))
pub const STATE_FORK_CURRENT_VERSION: u256 = concat(
    HEADER_STATE_ROOT,
    concat(field(STATE_FIELDS, 3), field(FORK_FIELDS, 1)),
)
pub const VALIDATORS_DATA: u256 = concat(HEADER_STATE_ROOT, concat(field(STATE_FIELDS, 11), 2))
pub const SLOTS_PER_HISTORICAL_ROOT: u256 = 8192
pub const STATE_BLOCK_ROOTS: u256 = concat(HEADER_STATE_ROOT, field(STATE_FIELDS, 5))
pub const STATE_HISTORICAL_SUMMARIES: u256 = concat(HEADER_STATE_ROOT, field(STATE_FIELDS, 27))
pub const HISTORICAL_SUMMARIES_LIMIT: u256 = 1 << 24
pub const SUMMARY_FIELDS: u256 = 2
pub const CAPELLA_FIRST_PERIOD: u64 = 758
pub const CAPELLA_FIRST_SLOT: u64 = 6209536

static_assert(HEADER_STATE_ROOT == 11)
static_assert(HEADER_BODY_ROOT == 12)
static_assert(PAYLOAD_STATE_ROOT == 6434)
static_assert(PAYLOAD_RECEIPTS_ROOT == 6435)
static_assert(PAYLOAD_BLOCK_NUMBER == 6438)
static_assert(PAYLOAD_BLOCK_HASH == 6444)
static_assert(STATE_GENESIS_VALIDATORS_ROOT == 705)
static_assert(STATE_BLOCK_ROOTS == 709)
static_assert(STATE_HISTORICAL_SUMMARIES == 731)
static_assert(CAPELLA_FIRST_PERIOD as u256 * SLOTS_PER_HISTORICAL_ROOT
    == CAPELLA_FIRST_SLOT as u256)
static_assert(STATE_FORK_CURRENT_VERSION == 2829)

pub enum PayloadField {
    StateRoot,
    ReceiptsRoot,
    BlockNumber,
    BlockHash,
}

impl PayloadField {
    pub const fn gindex(self) -> GIndex {
        GIndex::new(
            match self {
                Self::StateRoot => PAYLOAD_STATE_ROOT,
                Self::ReceiptsRoot => PAYLOAD_RECEIPTS_ROOT,
                Self::BlockNumber => PAYLOAD_BLOCK_NUMBER,
                Self::BlockHash => PAYLOAD_BLOCK_HASH,
            },
        )
    }
}

pub enum StateField {
    GenesisValidatorsRoot,
    ForkCurrentVersion,
}

impl StateField {
    pub const fn gindex(self) -> GIndex {
        GIndex::new(
            match self {
                Self::GenesisValidatorsRoot => STATE_GENESIS_VALIDATORS_ROOT,
                Self::ForkCurrentVersion => STATE_FORK_CURRENT_VERSION,
            },
        )
    }
}

pub enum ValidatorField {
    Pubkey,
    WithdrawalCredentials,
    EffectiveBalance,
}

impl ValidatorField {
    pub const fn index(self) -> u256 {
        match self {
            Self::Pubkey => 0,
            Self::WithdrawalCredentials => 1,
            Self::EffectiveBalance => 2,
        }
    }
}

pub const fn block_root_element_gindex(_ index: u64) -> GIndex {
    if index as u256 >= SLOTS_PER_HISTORICAL_ROOT {
        core::panic_code(PANIC_ASSERT)
    }
    GIndex::new(
        concat(
            STATE_BLOCK_ROOTS,
            SLOTS_PER_HISTORICAL_ROOT + index as u256,
        ),
    )
}

pub const fn summary_block_root_gindex(_ index: u64) -> GIndex {
    if index as u256 >= HISTORICAL_SUMMARIES_LIMIT {
        core::panic_code(PANIC_ASSERT)
    }
    GIndex::new(
        concat(
            STATE_HISTORICAL_SUMMARIES,
            concat(
                concat(2, HISTORICAL_SUMMARIES_LIMIT + index as u256),
                field(SUMMARY_FIELDS, 0),
            ),
        ),
    )
}

pub const fn validator_element_gindex(_ index: u64) -> GIndex {
    if index as u256 >= VALIDATOR_REGISTRY_LIMIT {
        core::panic_code(PANIC_ASSERT)
    }
    GIndex::new(
        concat(VALIDATORS_DATA, VALIDATOR_REGISTRY_LIMIT + index as u256),
    )
}

pub const fn validator_gindex(_ index: u64, _ which: ValidatorField) -> GIndex {
    GIndex::new(
        concat(
            validator_element_gindex(index).value(),
            field(VALIDATOR_FIELDS, which.index()),
        ),
    )
}

static_assert(summary_block_root_gindex(0).value() == 49056579584)
static_assert(summary_block_root_gindex(1).value() == 49056579586)
static_assert(summary_block_root_gindex(1155).value() == 49056581894)
static_assert(block_root_element_gindex(0).value() == 5808128)
static_assert(block_root_element_gindex(1).value() == 5808129)
static_assert(block_root_element_gindex(8191).value() == 5816319)
static_assert(validator_element_gindex(0).value() == 1572301627719680)
static_assert(validator_element_gindex(2345678).value() == 1572301630065358)
static_assert(validator_gindex(0, ValidatorField::Pubkey).value() == 12578413021757440)
static_assert(validator_gindex(0, ValidatorField::WithdrawalCredentials).value()
    == 12578413021757441)
static_assert(validator_gindex(2345678, ValidatorField::EffectiveBalance).value()
    == 12578413040522866)

pub struct BeaconBlockHeader {
    pub slot: u64,
    pub proposer_index: u64,
    pub parent_root: u256,
    pub state_root: u256,
    pub body_root: u256,
}

impl Copy for BeaconBlockHeader {}

impl BeaconBlockHeader {
    pub fn root(self) -> BeaconRoot {
        let left = hash_pair(
            hash_pair(u64_chunk(self.slot), u64_chunk(self.proposer_index)),
            hash_pair(self.parent_root, self.state_root),
        )
        let right = hash_pair(hash_pair(self.body_root, 0), hash_pair(0, 0))
        BeaconRoot::new(hash_pair(left, right))
    }
}

pub struct Validator {
    pub pubkey_root: u256,
    pub withdrawal_credentials: u256,
    pub effective_balance: u64,
    pub slashed: bool,
    pub activation_eligibility_epoch: u64,
    pub activation_epoch: u64,
    pub exit_epoch: u64,
    pub withdrawable_epoch: u64,
}

impl Copy for Validator {}

impl Validator {
    pub fn root(self) -> u256 {
        let slashed: u256 = if self.slashed { 1 << 248 } else { 0 }
        let left = hash_pair(
            hash_pair(self.pubkey_root, self.withdrawal_credentials),
            hash_pair(u64_chunk(self.effective_balance), slashed),
        )
        let right = hash_pair(
            hash_pair(
                u64_chunk(self.activation_eligibility_epoch),
                u64_chunk(self.activation_epoch),
            ),
            hash_pair(
                u64_chunk(self.exit_epoch),
                u64_chunk(self.withdrawable_epoch),
            ),
        )
        hash_pair(left, right)
    }
}

pub fn verify_execution_receipts_root<P: ProofNodes>(
    beacon_root: BeaconRoot,
    receipts_root: u256,
    branch: P,
) -> Result<ProofError, ReceiptsRoot> {
    verify_payload_field(
        beacon_root,
        which: PayloadField::ReceiptsRoot,
        leaf: receipts_root,
        branch,
    )?
    Result::Ok(ReceiptsRoot::new(receipts_root))
}

pub const PAYLOAD_MULTIPROOF_HELPERS: usize = 14

static_assert(PAYLOAD_STATE_ROOT ^ 1 == PAYLOAD_RECEIPTS_ROOT)
static_assert(PAYLOAD_STATE_ROOT / 2 == 3217)
static_assert(PAYLOAD_BLOCK_NUMBER / 2 == 3219)
static_assert(PAYLOAD_BLOCK_HASH / 2 == 3222)

pub fn verify_payload_multiproof<P: ProofNodes>(
    beacon_root: BeaconRoot,
    state_root: u256,
    receipts_root: u256,
    block_number_leaf: u256,
    block_hash: u256,
    helpers: P,
) -> Result<ProofError, ()> {
    let h = helpers.nodes()
    if h.len() != PAYLOAD_MULTIPROOF_HELPERS {
        return Result::Err(ProofError::WrongLength)
    }
    let n3222 = hash_pair(block_hash, h[0])
    let n3219 = hash_pair(block_number_leaf, h[1])
    let n3217 = hash_pair(state_root, receipts_root)
    let n1611 = hash_pair(n3222, h[2])
    let n1609 = hash_pair(h[3], n3219)
    let n1608 = hash_pair(h[4], n3217)
    let n805 = hash_pair(h[5], n1611)
    let n804 = hash_pair(n1608, n1609)
    let n402 = hash_pair(n804, n805)
    let n201 = hash_pair(n402, h[6])
    let n100 = hash_pair(h[7], n201)
    let n50 = hash_pair(n100, h[8])
    let n25 = hash_pair(n50, h[9])
    let n12 = hash_pair(h[10], n25)
    let n6 = hash_pair(n12, h[11])
    let n3 = hash_pair(n6, h[12])
    if hash_pair(h[13], n3) != beacon_root.value() {
        return Result::Err(ProofError::RootMismatch)
    }
    Result::Ok(())
}

pub fn verify_payload_field<P: ProofNodes>(
    beacon_root: BeaconRoot,
    which: PayloadField,
    leaf: u256,
    branch: P,
) -> Result<ProofError, ()> {
    verify_branch(
        root: beacon_root.as_root(),
        leaf,
        gindex: which.gindex(),
        branch,
    )
}

pub fn verify_execution_state_root<P: ProofNodes>(
    beacon_root: BeaconRoot,
    state_root: u256,
    branch: P,
) -> Result<ProofError, StateRoot> {
    verify_payload_field(
        beacon_root,
        which: PayloadField::StateRoot,
        leaf: state_root,
        branch,
    )?
    Result::Ok(StateRoot::new(state_root))
}

pub fn verify_state_field<P: ProofNodes>(
    beacon_root: BeaconRoot,
    which: StateField,
    leaf: u256,
    branch: P,
) -> Result<ProofError, ()> {
    verify_branch(
        root: beacon_root.as_root(),
        leaf,
        gindex: which.gindex(),
        branch,
    )
}

pub struct PqValidator {
    pub pubkey: u256,
    pub vrf_root: u256,
    pub withdrawal_credentials: u256,
    pub effective_balance: u64,
    pub slashed: bool,
    pub activation_eligibility_epoch: u64,
    pub activation_epoch: u64,
    pub exit_epoch: u64,
    pub withdrawable_epoch: u64,
}

impl Copy for PqValidator {}

impl PqValidator {
    pub fn root(self) -> u256 {
        let slashed: u256 = if self.slashed { 1 << 248 } else { 0 }
        let left = hash_pair(
            hash_pair(
                hash_pair(self.pubkey, self.vrf_root),
                hash_pair(
                    self.withdrawal_credentials,
                    u64_chunk(self.effective_balance),
                ),
            ),
            hash_pair(
                hash_pair(slashed, u64_chunk(self.activation_eligibility_epoch)),
                hash_pair(
                    u64_chunk(self.activation_epoch),
                    u64_chunk(self.exit_epoch),
                ),
            ),
        )
        let zero_pair = hash_pair(0, 0)
        let zero_four = hash_pair(zero_pair, zero_pair)
        let right = hash_pair(
            hash_pair(
                hash_pair(u64_chunk(self.withdrawable_epoch), 0),
                zero_pair,
            ),
            zero_four,
        )
        hash_pair(left, right)
    }
}

pub fn verify_historical_root<P: ProofNodes>(
    beacon_root: BeaconRoot,
    header_slot: u64,
    slot: u64,
    historical_root: u256,
    branch: P,
) -> Result<ProofError, ()> {
    if slot >= header_slot {
        return Result::Err(ProofError::IndexOutOfRange)
    }
    if (header_slot - slot) as u256 > SLOTS_PER_HISTORICAL_ROOT {
        return Result::Err(ProofError::IndexOutOfRange)
    }
    verify_branch(
        root: beacon_root.as_root(),
        leaf: historical_root,
        gindex: block_root_element_gindex(slot % 8192),
        branch,
    )
}

pub fn verify_deep_historical_root<P: ProofNodes, Q: ProofNodes>(
    beacon_root: BeaconRoot,
    header_slot: u64,
    slot: u64,
    historical_root: u256,
    summary_root: u256,
    summary_branch: P,
    vector_branch: Q,
) -> Result<ProofError, ()> {
    if slot < CAPELLA_FIRST_SLOT {
        return Result::Err(ProofError::IndexOutOfRange)
    }
    let period = slot / 8192
    if period >= header_slot / 8192 {
        return Result::Err(ProofError::IndexOutOfRange)
    }
    verify_branch(
        root: beacon_root.as_root(),
        leaf: summary_root,
        gindex: summary_block_root_gindex(period - CAPELLA_FIRST_PERIOD),
        branch: summary_branch,
    )?
    verify_branch(
        root: Root::new(summary_root),
        leaf: historical_root,
        gindex: GIndex::new(SLOTS_PER_HISTORICAL_ROOT + (slot % 8192) as u256),
        branch: vector_branch,
    )
}

pub fn verify_validator<P: ProofNodes>(
    beacon_root: BeaconRoot,
    index: u64,
    validator: Validator,
    branch: P,
) -> Result<ProofError, ()> {
    if index as u256 >= VALIDATOR_REGISTRY_LIMIT {
        return Result::Err(ProofError::IndexOutOfRange)
    }
    verify_branch(
        root: beacon_root.as_root(),
        leaf: validator.root(),
        gindex: validator_element_gindex(index),
        branch,
    )
}

pub fn verify_validator_field<P: ProofNodes>(
    beacon_root: BeaconRoot,
    index: u64,
    which: ValidatorField,
    leaf: u256,
    branch: P,
) -> Result<ProofError, ()> {
    if index as u256 >= VALIDATOR_REGISTRY_LIMIT {
        return Result::Err(ProofError::IndexOutOfRange)
    }
    verify_branch(
        root: beacon_root.as_root(),
        leaf,
        gindex: validator_gindex(index, which),
        branch,
    )
}
