use core::message::MsgVariant
use core::MemSpan
use std::abi::{Bytes, Bytes32, DynArray, Sol, SolCompat, sol}
use std::evm::crypto::keccak256
use std::evm::rlp
use std::evm::{Address, Call, Ctx, revert_error}
use ingot::beacon::verify_gloas_latest_block_hash
use ingot::consumer::{
    address_bytes,
    beacon_root,
    checked,
    BeaconRootsWithoutCode,
    Header,
    HeaderMismatch,
}
use ingot::mpt::HASH_LEN
use ingot::{
    verify_account,
    verify_storage,
    AccountState,
    BeaconBlockHeader,
    ProofError,
    Proven,
    StateRoot,
}

pub const EXECUTION_STATE_ROOT_FIELD: usize = 3

#[error]
pub struct AccountMissing {}

#[error]
pub struct BelowFloor { pub value: u256, pub floor: u256 }

pub fn execution_state_root(_ header_rlp: MemSpan, block_hash: u256) -> Result<
    ProofError,
    StateRoot,
> {
    if keccak256(header_rlp) != block_hash {
        return Result::Err(ProofError::RootMismatch)
    }
    let item = match rlp::decode(header_rlp) {
        Option::Some(item) => item,
        Option::None => {
            return Result::Err(ProofError::BadRlp)
        },
    }
    if !item.is_list() {
        return Result::Err(ProofError::BadRlp)
    }
    let fields = match item.items(header_rlp) {
        Option::Some(fields) => fields,
        Option::None => {
            return Result::Err(ProofError::BadRlp)
        },
    }
    if fields.len() <= EXECUTION_STATE_ROOT_FIELD {
        return Result::Err(ProofError::BadRlp)
    }
    if fields[EXECUTION_STATE_ROOT_FIELD].is_list() {
        return Result::Err(ProofError::BadRlp)
    }
    let root_bytes = fields[EXECUTION_STATE_ROOT_FIELD].payload(header_rlp)
    if root_bytes.len() != HASH_LEN {
        return Result::Err(ProofError::WrongLength)
    }
    Result::Ok(StateRoot::new(root_bytes.read_word(0)))
}

pub msg FrameGateMsg {
    #[selector = sol(
        "checkPay(uint64,(uint64,uint64,bytes32,bytes32,bytes32),bytes32,bytes32[],bytes,bytes[],bytes[])",
    )]
    CheckPay {
        timestamp: u64,
        header: Header,
        latest_block_hash: Bytes32,
        block_hash_branch: DynArray<Bytes32>,
        execution_header: Bytes,
        account_nodes: DynArray<Bytes>,
        storage_nodes: DynArray<Bytes>,
    } -> u256,
}

static_assert(<FrameGateMsg::CheckPay as MsgVariant<Sol>>::SELECTOR
    == sol(
        (
            "checkPay",
            <(
                u64,
                Header,
                Bytes32,
                DynArray<Bytes32>,
                Bytes,
                DynArray<Bytes>,
                DynArray<Bytes>,
            ) as SolCompat>::SOL_TYPE,
        ),
    ))

pub contract FrameGate uses (call: Call, ctx: Ctx) {
    beacon_roots: Address,
    account: Address,
    slot: u256,
    floor: u256,

    init(roots: Address, watched: Address, watched_slot: u256, value_floor: u256)
    uses (ctx, mut beacon_roots, mut account, mut slot, mut floor)
    {
        if ctx.extcodesize(roots) == 0 {
            revert_error(BeaconRootsWithoutCode { roots })
        }
        beacon_roots = roots
        account = watched
        slot = watched_slot
        floor = value_floor
    }

    recv FrameGateMsg {
        CheckPay {
            timestamp,
            header,
            latest_block_hash,
            block_hash_branch,
            execution_header,
            account_nodes,
            storage_nodes,
        } -> u256
        uses (call, ctx, beacon_roots, account, slot, floor)
        {
            let root = beacon_root(beacon_roots, timestamp)
            let computed = BeaconBlockHeader {
                slot: header.slot,
                proposer_index: header.proposer_index,
                parent_root: header.parent_root.val,
                state_root: header.state_root.val,
                body_root: header.body_root.val,
            }
                .root()
            if computed != root {
                revert_error(HeaderMismatch { root: Bytes32 { val: root.value() } })
            }
            checked(
                verify_gloas_latest_block_hash(
                    beacon_root: root,
                    block_hash: latest_block_hash.val,
                    branch: block_hash_branch,
                ),
            )
            let execution_root = checked(
                execution_state_root(
                    execution_header.span(),
                    block_hash: latest_block_hash.val,
                ),
            )
            let account_state = match checked(
                verify_account(
                    state_root: execution_root,
                    address_bytes(account),
                    nodes: account_nodes.to_mem_array(),
                ),
            ) {
                Proven::Present(found) => found,
                Proven::Absent => revert_error(AccountMissing {}),
            }
            let value = checked(
                verify_storage(
                    storage_root: account_state.storage_root,
                    slot,
                    nodes: storage_nodes.to_mem_array(),
                ),
            )
            if value < floor {
                revert_error(BelowFloor { value, floor })
            }
            value
        }
    }
}
