pub struct AccountState {
    pub nonce: u64,
    pub balance: u256,
    pub storage_root: StorageRoot,
    pub code_hash: CodeHash,
}

impl Copy for AccountState {}

impl Eq for AccountState {
    const fn eq(self, _ other: Self) -> bool {
        self.nonce == other.nonce
            && self.balance == other.balance
            && self.storage_root == other.storage_root
            && self.code_hash == other.code_hash
    }
}

impl Default for AccountState {
    fn default() -> Self {
        AccountState::missing()
    }
}

impl AccountState {
    pub const fn missing() -> Self {
        AccountState {
            nonce: 0,
            balance: 0,
            storage_root: StorageRoot::empty(),
            code_hash: CodeHash::empty(),
        }
    }

    pub const fn is_empty(self) -> bool {
        self.nonce == 0 && self.balance == 0 && self.code_hash == CodeHash::empty()
    }
}

pub enum Proven<T> {
    Present(T),
    Absent,
}

impl<T> Copy for Proven<T> where T: Copy {}

impl<T: Eq> Eq for Proven<T> {
    fn eq(self, _ other: Self) -> bool {
        match self {
            Self::Present(ref value) => match other {
                Proven::Present(ref other_value) => value == other_value,
                Proven::Absent => false,
            },
            Self::Absent => other.is_absent(),
        }
    }
}

impl<T> Proven<T> {
    pub fn is_present(self) -> bool {
        match self {
            Self::Present(_) => true,
            Self::Absent => false,
        }
    }

    pub fn is_absent(self) -> bool {
        !self.is_present()
    }
}

pub enum ProofError {
    BadRlp,
    HashMismatch(usize),
    PathExhausted,
    TrailingNodes,
    BadHexPrefix,
    BranchValueOnPath,
    DepthOutOfRange,
    RootMismatch,
    KeyNotConsumed,
    IndexOutOfRange,
}

impl Copy for ProofError {}

impl Eq for ProofError {
    fn eq(self, _ other: Self) -> bool {
        match (self, other) {
            (Self::BadRlp, Self::BadRlp) => true,
            (Self::HashMismatch(depth), Self::HashMismatch(other_depth)) => depth == other_depth,
            (Self::PathExhausted, Self::PathExhausted) => true,
            (Self::TrailingNodes, Self::TrailingNodes) => true,
            (Self::BadHexPrefix, Self::BadHexPrefix) => true,
            (Self::BranchValueOnPath, Self::BranchValueOnPath) => true,
            (Self::DepthOutOfRange, Self::DepthOutOfRange) => true,
            (Self::RootMismatch, Self::RootMismatch) => true,
            (Self::KeyNotConsumed, Self::KeyNotConsumed) => true,
            (Self::IndexOutOfRange, Self::IndexOutOfRange) => true,
            _ => false,
        }
    }
}
