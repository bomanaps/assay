impl StateRoot {
    pub const fn new(_ value: u256) -> Self {
        StateRoot(value)
    }

    pub const fn value(self) -> u256 {
        self.0
    }

    pub const fn as_root(self) -> Root {
        Root(self.0)
    }
}

pub struct StorageRoot(u256)

impl Copy for StorageRoot {}
impl Snapshot for StorageRoot {}

impl Eq for StorageRoot {
    const fn eq(self, _ other: Self) -> bool {
        self.0 == other.0
    }
}

impl StorageRoot {
    pub const fn new(_ value: u256) -> Self {
        StorageRoot(value)
    }

    pub const fn empty() -> Self {
        StorageRoot(EMPTY_STORAGE_ROOT)
    }

    pub const fn value(self) -> u256 {
        self.0
    }

    pub const fn as_root(self) -> Root {
        Root(self.0)
    }
}

