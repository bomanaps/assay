use core::ops::Eq
use core::marker::Snapshot
use core::default::Default

pub const EMPTY_STORAGE_ROOT: u256 = 0x56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421
pub const EMPTY_CODE_HASH: u256 = 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470

pub struct Root(u256)

impl Copy for Root {}
impl Snapshot for Root {}

impl Eq for Root {
    const fn eq(self, _ other: Self) -> bool {
        self.0 == other.0
    }
}

impl Root {
    pub const fn new(_ value: u256) -> Self {
        Root(value)
    }

    pub const fn value(self) -> u256 {
        self.0
    }
}

pub struct StateRoot(u256)

impl Copy for StateRoot {}
impl Snapshot for StateRoot {}

impl Eq for StateRoot {
    const fn eq(self, _ other: Self) -> bool {
        self.0 == other.0
    }
