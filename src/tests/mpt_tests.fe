use core::default::Default
use ingot::fixtures::{
    mainnet_account_absent,
    mainnet_account_eoa,
    mainnet_storage_absent,
    mainnet_storage_usdc,
    mainnet_storage_weth,
}
use ingot::{
    verify_account,
    verify_storage,
    AccountState,
    CodeHash,
    NodeList,
    Proven,
    StateRoot,
    StorageRoot,
}

fn expect_account<const N: usize, const M: usize>(
    state_root: u256,
    _ address: [u8; 20],
    _ bytes: [u8; N],
    _ offsets: [usize; M],
    node_count: usize,
) -> Proven<AccountState> {
    let nodes = NodeList::from_fixture(bytes, offsets, first: 0, count: node_count)
    match verify_account(state_root: StateRoot::new(state_root), address, nodes) {
        Result::Ok(proven) => proven,
        Result::Err(_) => {
            core::assert(false)
            Proven::Absent
        },
    }
}

fn expect_slots<const N: usize, const M: usize, const S: usize, const K: usize>(
    storage_root: u256,
    _ bytes: [u8; N],
    _ offsets: [usize; M],
    _ starts: [usize; S],
    _ keys: [u256; K],
    _ values: [u256; K],
) {
    var slot: usize = 0
    while slot < K {
        let nodes = NodeList::from_fixture(
            bytes,
            offsets,
            first: starts[slot],
            count: starts[slot + 1] - starts[slot],
        )
        match verify_storage(
            storage_root: StorageRoot::new(storage_root),
            slot: keys[slot],
            nodes,
        ) {
            Result::Ok(value) => core::assert(value == values[slot]),
            Result::Err(_) => core::assert(false),
        }
        slot += 1
    }
}

#[test]
fn eoa_account_decodes_to_the_oracle_values() {
    let proven = expect_account(
        state_root: mainnet_account_eoa::STATE_ROOT,
        mainnet_account_eoa::ADDRESS_BYTES,
        mainnet_account_eoa::ACCOUNT_BYTES,
        mainnet_account_eoa::ACCOUNT_OFFSETS,
        node_count: mainnet_account_eoa::ACCOUNT_NODE_COUNT,
    )
    match proven {
        Proven::Present(account) => {
            core::assert(account.nonce == mainnet_account_eoa::NONCE)
            core::assert(account.balance == mainnet_account_eoa::BALANCE)
            core::assert(
                account.storage_root == StorageRoot::new(mainnet_account_eoa::STORAGE_ROOT),
            )
            core::assert(
                account.code_hash == CodeHash::new(mainnet_account_eoa::CODE_HASH),
            )
        },
        Proven::Absent => core::assert(false),
    }
}

#[test]
fn absent_account_is_proven_absent() {
    let proven = expect_account(
        state_root: mainnet_account_absent::STATE_ROOT,
        mainnet_account_absent::ADDRESS_BYTES,
        mainnet_account_absent::ACCOUNT_BYTES,
        mainnet_account_absent::ACCOUNT_OFFSETS,
        node_count: mainnet_account_absent::ACCOUNT_NODE_COUNT,
    )
    core::assert(
        proven.is_present() == mainnet_account_absent::ACCOUNT_PRESENT,
    )
    let reported = AccountState {
        nonce: mainnet_account_absent::NONCE,
        balance: mainnet_account_absent::BALANCE,
        storage_root: StorageRoot::new(mainnet_account_absent::STORAGE_ROOT),
        code_hash: CodeHash::new(mainnet_account_absent::CODE_HASH),
    }
    core::assert(AccountState::missing() == reported)
    core::assert(AccountState::default() == reported)
    core::assert(reported.is_empty())
}

#[test]
fn usdc_account_and_slot_decode_to_the_oracle_values() {
    let proven = expect_account(
        state_root: mainnet_storage_usdc::STATE_ROOT,
        mainnet_storage_usdc::ADDRESS_BYTES,
        mainnet_storage_usdc::ACCOUNT_BYTES,
        mainnet_storage_usdc::ACCOUNT_OFFSETS,
        node_count: mainnet_storage_usdc::ACCOUNT_NODE_COUNT,
    )
    match proven {
        Proven::Present(account) => {
            core::assert(account.nonce == mainnet_storage_usdc::NONCE)
            core::assert(account.balance == mainnet_storage_usdc::BALANCE)
            core::assert(
                account.storage_root == StorageRoot::new(mainnet_storage_usdc::STORAGE_ROOT),
            )
            core::assert(
                account.code_hash == CodeHash::new(mainnet_storage_usdc::CODE_HASH),
            )
        },
        Proven::Absent => core::assert(false),
    }
    expect_slots(
        storage_root: mainnet_storage_usdc::STORAGE_ROOT,
        mainnet_storage_usdc::SLOT_BYTES,
        mainnet_storage_usdc::SLOT_OFFSETS,
        mainnet_storage_usdc::SLOT_NODE_STARTS,
        mainnet_storage_usdc::SLOT_KEYS,
        mainnet_storage_usdc::SLOT_VALUES,
    )
}

#[test]
fn absent_slot_is_proven_zero() {
    expect_slots(
        storage_root: mainnet_storage_absent::STORAGE_ROOT,
        mainnet_storage_absent::SLOT_BYTES,
        mainnet_storage_absent::SLOT_OFFSETS,
        mainnet_storage_absent::SLOT_NODE_STARTS,
        mainnet_storage_absent::SLOT_KEYS,
        mainnet_storage_absent::SLOT_VALUES,
    )
}

#[test]
fn weth_account_and_three_slots_decode_to_the_oracle_values() {
    let proven = expect_account(
        state_root: mainnet_storage_weth::STATE_ROOT,
        mainnet_storage_weth::ADDRESS_BYTES,
        mainnet_storage_weth::ACCOUNT_BYTES,
        mainnet_storage_weth::ACCOUNT_OFFSETS,
        node_count: mainnet_storage_weth::ACCOUNT_NODE_COUNT,
    )
    match proven {
        Proven::Present(account) => {
            core::assert(account.nonce == mainnet_storage_weth::NONCE)
            core::assert(account.balance == mainnet_storage_weth::BALANCE)
            core::assert(
                account.storage_root == StorageRoot::new(mainnet_storage_weth::STORAGE_ROOT),
            )
            core::assert(
                account.code_hash == CodeHash::new(mainnet_storage_weth::CODE_HASH),
            )
        },
        Proven::Absent => core::assert(false),
    }
    expect_slots(
        storage_root: mainnet_storage_weth::STORAGE_ROOT,
        mainnet_storage_weth::SLOT_BYTES,
        mainnet_storage_weth::SLOT_OFFSETS,
        mainnet_storage_weth::SLOT_NODE_STARTS,
        mainnet_storage_weth::SLOT_KEYS,
        mainnet_storage_weth::SLOT_VALUES,
    )
}
