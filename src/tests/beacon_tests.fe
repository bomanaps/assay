use ingot::fixtures::{chain_beacon, chain_storage_usdc as usdc, chain_storage_weth as weth}
use ingot::{
    verify_account,
    verify_execution_state_root,
    verify_storage,
    AccountState,
    BeaconRoot,
    Branch,
    NodeList,
    Proven,
    StateRoot,
    StorageRoot,
}

fn proven_state_root() -> StateRoot {
    match verify_execution_state_root(
        beacon_root: BeaconRoot::new(chain_beacon::BLOCK_ROOT),
        state_root: chain_beacon::PAYLOAD_STATE_ROOT_LEAF,
        branch: Branch::new(chain_beacon::PAYLOAD_STATE_ROOT_BRANCH),
    ) {
        Result::Ok(state_root) => state_root,
        Result::Err(_) => {
            core::assert(false)
            StateRoot::new(0)
        },
    }
}

fn account_at<const N: usize, const M: usize>(
    state_root: StateRoot,
    _ address: [u8; 20],
    _ bytes: [u8; N],
    _ offsets: [usize; M],
    count: usize,
) -> AccountState {
    let nodes = NodeList::from_fixture(bytes, offsets, first: 0, count)
    match verify_account(state_root, address, nodes) {
        Result::Ok(Proven::Present(account)) => account,
        _ => {
            core::assert(false)
            AccountState::missing()
        },
    }
}

#[test]
fn storage_is_proven_from_the_beacon_block_root_alone() {
    let state_root = proven_state_root()
    let usdc_account = account_at(
        state_root,
        usdc::ADDRESS_BYTES,
        usdc::ACCOUNT_BYTES,
        usdc::ACCOUNT_OFFSETS,
        count: usdc::ACCOUNT_NODE_COUNT,
    )
    core::assert(
        usdc_account.storage_root == StorageRoot::new(usdc::STORAGE_ROOT),
    )
    let usdc_slot = NodeList::from_fixture(
        usdc::SLOT_BYTES,
        usdc::SLOT_OFFSETS,
        first: 0,
        count: usdc::SLOT_NODE_STARTS[1] - usdc::SLOT_NODE_STARTS[0],
    )
    match verify_storage(
        storage_root: usdc_account.storage_root,
        slot: usdc::SLOT_KEYS[0],
        nodes: usdc_slot,
    ) {
        Result::Ok(value) => core::assert(value == usdc::SLOT_VALUES[0]),
        Result::Err(_) => core::assert(false),
    }
    let weth_account = account_at(
        state_root,
        weth::ADDRESS_BYTES,
        weth::ACCOUNT_BYTES,
        weth::ACCOUNT_OFFSETS,
        count: weth::ACCOUNT_NODE_COUNT,
    )
    var slot: usize = 0
    while slot < 3 {
        let nodes = NodeList::from_fixture(
            weth::SLOT_BYTES,
            weth::SLOT_OFFSETS,
            first: weth::SLOT_NODE_STARTS[slot],
            count: weth::SLOT_NODE_STARTS[slot + 1] - weth::SLOT_NODE_STARTS[slot],
        )
        match verify_storage(
            storage_root: weth_account.storage_root,
            slot: weth::SLOT_KEYS[slot],
            nodes,
        ) {
            Result::Ok(value) => core::assert(value == weth::SLOT_VALUES[slot]),
            Result::Err(_) => core::assert(false),
        }
        slot += 1
    }
}
