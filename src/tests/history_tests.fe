use ingot::fixtures::history_day_old as h
use ingot::beacon::block_root_element_gindex
use ingot::{
    verify_historical_root,
    Branch,
    BeaconProver,
    BeaconRoot,
    Header,
    InvalidProof,
    ProofError,
    ProverMsg,
}
use core::{MemBuffer, MemVec}
use std::abi::{Bytes32, DynArray}
use std::evm::{Address, CallOutcome, Evm, RawOps, is_error}

fn anchor() -> BeaconRoot {
    BeaconRoot::new(h::BLOCK_ROOT)
}

#[test]
fn the_day_old_block_root_is_proven_from_the_anchor() {
    core::assert(
        h::BLOCK_ROOTS_ELEMENT_GINDEX == block_root_element_gindex(h::TARGET_SLOT % 8192).value(),
    )
    match verify_historical_root(
        beacon_root: anchor(),
        header_slot: h::SLOT,
        slot: h::TARGET_SLOT,
        historical_root: h::HISTORICAL_ROOT,
        branch: Branch::new(h::BLOCK_ROOTS_ELEMENT_BRANCH),
    ) {
        Result::Ok(()) => {},
        Result::Err(_) => core::assert(false),
    }
}

#[test]
fn a_slot_at_or_after_the_anchor_is_refused() {
    match verify_historical_root(
        beacon_root: anchor(),
        header_slot: h::SLOT,
        slot: h::SLOT,
        historical_root: h::HISTORICAL_ROOT,
        branch: Branch::new(h::BLOCK_ROOTS_ELEMENT_BRANCH),
    ) {
        Result::Err(ProofError::IndexOutOfRange) => {},
        _ => core::assert(false),
    }
}

#[test]
fn a_slot_beyond_the_window_is_refused() {
    let too_old = h::SLOT - 8193
    match verify_historical_root(
        beacon_root: anchor(),
        header_slot: h::SLOT,
        slot: too_old,
        historical_root: h::HISTORICAL_ROOT,
        branch: Branch::new(h::BLOCK_ROOTS_ELEMENT_BRANCH),
    ) {
        Result::Err(ProofError::IndexOutOfRange) => {},
        _ => core::assert(false),
    }
}

#[test]
fn the_farthest_spec_legal_slot_passes_the_window_check() {
    match verify_historical_root(
        beacon_root: anchor(),
        header_slot: h::SLOT,
        slot: h::SLOT - 8192,
        historical_root: h::HISTORICAL_ROOT,
        branch: Branch::new(h::BLOCK_ROOTS_ELEMENT_BRANCH),
    ) {
        Result::Err(ProofError::RootMismatch) => {},
        Result::Err(ProofError::IndexOutOfRange) => core::assert(false),
        _ => core::assert(false),
    }
}

#[test]
fn a_neighbouring_slot_cannot_reuse_the_branch() {
    match verify_historical_root(
        beacon_root: anchor(),
        header_slot: h::SLOT,
        slot: h::TARGET_SLOT - 1,
        historical_root: h::HISTORICAL_ROOT,
        branch: Branch::new(h::BLOCK_ROOTS_ELEMENT_BRANCH),
    ) {
        Result::Err(ProofError::RootMismatch) => {},
        _ => core::assert(false),
    }
}

#[test]
fn a_flipped_branch_word_is_refused() {
    var tampered = h::BLOCK_ROOTS_ELEMENT_BRANCH
    tampered[7] = tampered[7] ^ 1
    match verify_historical_root(
        beacon_root: anchor(),
        header_slot: h::SLOT,
        slot: h::TARGET_SLOT,
        historical_root: h::HISTORICAL_ROOT,
        branch: Branch::new(tampered),
    ) {
        Result::Err(ProofError::RootMismatch) => {},
        _ => core::assert(false),
    }
}

#[test]
fn a_different_claimed_root_is_refused() {
    match verify_historical_root(
        beacon_root: anchor(),
        header_slot: h::SLOT,
        slot: h::TARGET_SLOT,
        historical_root: h::HISTORICAL_ROOT ^ 1,
        branch: Branch::new(h::BLOCK_ROOTS_ELEMENT_BRANCH),
    ) {
        Result::Err(ProofError::RootMismatch) => {},
        _ => core::assert(false),
    }
}

const GAS: u256 = 30000000
const OPEN_END: u64 = 0xffffffffffffffff
const ROOT_MISMATCH_CODE: u256 = 8

contract HistoryMockRoots uses (ops: RawOps) {
    mut timestamp: u256,
    mut root: u256,

    init(key: u256, value: u256)
    uses (mut timestamp, mut root)
    {
        timestamp = key
        root = value
    }

    recv {
        _ uses (ops, timestamp, root) {
            if ops.calldatasize() != 32 || ops.calldataload(0) != timestamp {
                ops.revert(data: MemBuffer::empty().span())
            }
            var out = MemBuffer::new(32)
            out.write_word(offset: 0, value: root)
            ops.return_data(data: out.span())
        }
    }
}

fn header() -> Header {
    Header {
        slot: h::SLOT,
        proposer_index: h::PROPOSER_INDEX,
        parent_root: Bytes32 { val: h::PARENT_ROOT },
        state_root: Bytes32 { val: h::HEADER_STATE_ROOT },
        body_root: Bytes32 { val: h::BODY_ROOT },
    }
}

fn words<const N: usize>(_ values: [u256; N]) -> DynArray<Bytes32> {
    var out: MemVec<Bytes32> = MemVec::new()
    var i: usize = 0
    while i < N {
        out.push(Bytes32 { val: values[i] })
        i += 1
    }
    DynArray::from_mem_vec(out)
}

fn history_prover() -> Address uses (evm: mut Evm) {
    let roots = evm
        .create2<HistoryMockRoots>(
            value: Wei::zero(),
            args: (h::CHILD_TIMESTAMP as u256, h::BLOCK_ROOT),
            salt: 0,
        )
    evm.create2<BeaconProver>(value: Wei::zero(), args: (roots, OPEN_END), salt: 0)
}

fn history_call(prover: Address, slot: u64, root: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: prover,
        gas: GAS,
        value: Wei::zero(),
        message: ProverMsg::ProveHistoricalRoot {
            timestamp: h::CHILD_TIMESTAMP,
            header: header(),
            slot,
            historical_root: Bytes32 { val: root },
            branch: words(h::BLOCK_ROOTS_ELEMENT_BRANCH),
        },
    )
}

#[cfg(target = "evm")]
#[test]
fn an_older_block_root_is_proven_through_the_contract() uses (evm: mut Evm) {
    let prover = history_prover()
    let outcome = history_call(prover, slot: h::TARGET_SLOT, root: h::HISTORICAL_ROOT)
    core::assert(outcome.success())
    let data = outcome.returndata()
    core::assert(data.len() == 64)
    core::assert(data.read_word(0) == h::TARGET_SLOT as u256)
    core::assert(data.read_word(32) == h::SLOT as u256)
}

#[cfg(target = "evm")]
#[test]
fn a_forged_historical_root_reverts_on_chain() uses (evm: mut Evm) {
    let prover = history_prover()
    let outcome = history_call(prover, slot: h::TARGET_SLOT, root: h::HISTORICAL_ROOT ^ 1)
    core::assert(!outcome.success())
    core::assert(is_error<InvalidProof>(outcome.returndata()))
    core::assert(outcome.returndata().read_word(4) == ROOT_MISMATCH_CODE)
}
