fn list1<const A: usize>(_ a: [u8; A]) -> NodeList {
    var nodes = NodeList::new()
    nodes.push(load(a).span())
    nodes
}

fn list3<const A: usize, const B: usize, const C: usize>(
    _ a: [u8; A],
    _ b: [u8; B],
    _ c: [u8; C],
) -> NodeList {
    var nodes = NodeList::new()
    nodes.push(load(a).span())
    nodes.push(load(b).span())
    nodes.push(load(c).span())
    nodes
}

fn root_of<const A: usize>(_ a: [u8; A]) -> Root {
    Root::new(keccak256(load(a).span()))
}

fn present_byte(_ root: Root, key: u256, _ nodes: NodeList) -> u8 {
    match verify_trie(root, key: TrieKey::new(key), nodes) {
        Result::Ok(Proven::Present(leaf)) => {
            let value = leaf.item.payload(nodes.node(leaf.node))
            core::assert(value.len() == 1)
            value.byte_at(0)
        },
        _ => {
            core::assert(false)
            0
        },
    }
}

fn is_absent(_ root: Root, key: u256, _ nodes: NodeList) -> bool {
    match verify_trie(root, key: TrieKey::new(key), nodes) {
        Result::Ok(proven) => proven.is_absent(),
        Result::Err(_) => false,
    }
}

fn error_of(_ root: Root, key: u256, _ nodes: NodeList) -> ProofError {
    match verify_trie(root, key: TrieKey::new(key), nodes) {
        Result::Ok(_) => {
            core::assert(false)
            ProofError::BadRlp
        },
        Result::Err(error) => error,
    }
}

#[test]
fn extension_into_an_embedded_branch_reaches_embedded_leaves() {
    let root = root_of(EXT_INLINE)
    core::assert(present_byte(root, key: K1, list1(EXT_INLINE)) == 0x0a)
    core::assert(present_byte(root, key: K2, list1(EXT_INLINE)) == 0x0b)
}

#[test]
fn empty_slot_in_an_embedded_branch_proves_absence() {
    core::assert(is_absent(root_of(EXT_INLINE), key: K3, list1(EXT_INLINE)))
}

#[test]
fn key_diverging_inside_an_extension_proves_absence() {
    core::assert(is_absent(root_of(EXT_INLINE), key: K4, list1(EXT_INLINE)))
}

#[test]
fn node_after_an_embedded_terminal_is_rejected() {
    var nodes = list1(EXT_INLINE)
    nodes.duplicate_last()
    core::assert(
        error_of(root_of(EXT_INLINE), key: K1, nodes) == ProofError::TrailingNodes,
    )
}

#[test]
fn extension_into_hashed_nodes_reaches_the_leaf() {
    let root = root_of(EXT_HASHED)
    let nodes = list3(EXT_HASHED, BRANCH_HASHED, LEAF_HASHED_1)
    match verify_trie(root, key: TrieKey::new(K1), nodes) {
        Result::Ok(Proven::Present(leaf)) => {
            core::assert(leaf.node == 2)
            let value = leaf.item.payload(nodes.node(2))
            core::assert(value.len() == 32)
            core::assert(
                value.read_word(0)
                    == 0x1111111111111111111111111111111111111111111111111111111111111111,
            )
        },
        _ => core::assert(false),
    }
}

#[test]
fn hashed_branch_proves_absence_of_an_unset_slot() {
    var nodes = list3(EXT_HASHED, BRANCH_HASHED, LEAF_HASHED_1)
    nodes.drop_last()
    core::assert(is_absent(root_of(EXT_HASHED), key: K3, nodes))
}

#[test]
fn wrong_leaf_under_a_hashed_branch_is_rejected() {
    let nodes = list3(EXT_HASHED, BRANCH_HASHED, LEAF_HASHED_1)
    core::assert(
        error_of(root_of(EXT_HASHED), key: K2, nodes) == ProofError::HashMismatch(2),
    )
}

#[test]
fn extension_with_an_empty_child_is_rejected() {
    core::assert(
        error_of(root_of(EXT_EMPTY_CHILD), key: K1, list1(EXT_EMPTY_CHILD)) == ProofError::BadRlp,
    )
}

#[test]
fn embedded_child_of_thirty_two_bytes_is_rejected() {
    core::assert(
        error_of(
                root_of(BIG_INLINE_BRANCH),
                key: KEY_A,
                list1(BIG_INLINE_BRANCH),
            )
            == ProofError::BadRlp,
    )
}

#[test]
fn hashed_non_root_node_shorter_than_thirty_two_bytes_is_rejected() {
    let short: [u8; 3] = [0xc2, 0x3a, 0x01]
    var nodes = list1(SHORT_CHILD_PARENT)
    nodes.push(load(short).span())
    core::assert(
        error_of(root_of(SHORT_CHILD_PARENT), key: KEY_A, nodes) == ProofError::BadRlp,
    )
}

#[test]
fn list_in_the_branch_value_slot_mid_path_is_rejected() {
    var node: [u8; 19] = [0x80; 19]
    node[0] = 0xd2
    node[17] = 0xc1
    node[18] = 0x01
    core::assert(
        error_of(root_of(node), key: KEY_A, list1(node)) == ProofError::BranchValueOnPath,
    )
}
