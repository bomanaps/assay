use ingot::fixture_support::load
use ingot::fixtures::{
    chain_account_absent as absent,
    chain_beacon as c,
    chain_storage_usdc as usdc,
    chain_storage_weth as weth,
    validator_beacon as v,
    validator_slashed as s,
}
use ingot::{
    proof_error_code,
    BeaconBlockHeader,
    BeaconProver,
    Header,
    HeaderMismatch,
    InvalidProof,
    NodeList,
    ProofError,
    ProofNodes,
    ProverMsg,
    RootUnavailable,
    UnsupportedSlot,
    ValidatorRecord,
    FULU_FIRST_SLOT,
}
use core::{MemBuffer, MemVec}
use std::abi::{Bytes, Bytes32, DynArray}
use std::evm::{Address, CallOutcome, Evm, RawOps, is_error}

const ANSWER: u256 = 0
const REVERT: u256 = 1
const SHORT: u256 = 2
const LONG: u256 = 3
const EMPTY: u256 = 4
const GAS: u256 = 30000000
const OPEN_END: u64 = 0xffffffffffffffff
const HASH_MISMATCH_CODE: u256 = 2
const DEPTH_OUT_OF_RANGE_CODE: u256 = 7
const ROOT_MISMATCH_CODE: u256 = 8
const INDEX_OUT_OF_RANGE_CODE: u256 = 10
const WRONG_LENGTH_CODE: u256 = 11
const PATH_EXHAUSTED_CODE: u256 = 3
const TRAILING_NODES_CODE: u256 = 4

contract MockBeaconRoots uses (ops: RawOps) {
    mut mode: u256,
    mut timestamp: u256,
    mut root: u256,

    init(behaviour: u256, key: u256, value: u256)
    uses (mut mode, mut timestamp, mut root)
    {
        mode = behaviour
        timestamp = key
        root = value
    }

    recv {
        _ uses (ops, mode, timestamp, root) {
            if ops.calldatasize() != 32
                || ops.calldataload(0) == 0
                || ops.calldataload(0) != timestamp {
                ops.revert(data: MemBuffer::empty().span())
            }
            let len: usize = if mode == SHORT {
                31
            } else if mode == LONG {
                64
            } else if mode == EMPTY { 0 } else { 32 }
            var out = MemBuffer::new(64)
            out.write_word(offset: 0, value: root)
            if mode == REVERT {
                ops.revert(data: out.slice(offset: 0, len))
            }
            ops.return_data(data: out.slice(offset: 0, len))
        }
    }
}

fn header() -> Header {
    Header {
        slot: c::SLOT,
        proposer_index: c::PROPOSER_INDEX,
        parent_root: Bytes32 { val: c::PARENT_ROOT },
        state_root: Bytes32 { val: c::HEADER_STATE_ROOT },
        body_root: Bytes32 { val: c::BODY_ROOT },
    }
}

fn root_of(_ h: Header) -> u256 {
    BeaconBlockHeader {
        slot: h.slot,
        proposer_index: h.proposer_index,
        parent_root: h.parent_root.val,
        state_root: h.state_root.val,
        body_root: h.body_root.val,
    }
        .root()
        .value()
}

fn words<const N: usize>(_ values: [u256; N]) -> DynArray<Bytes32> {
    var out: MemVec<Bytes32> = MemVec::new()
    var i: usize = 0
    while i < N {
        out.push(Bytes32 { val: values[i] })
        i += 1
    }
    DynArray::from_mem_vec(out)
}

fn abi_nodes(_ list: NodeList) -> DynArray<Bytes> {
    var out: MemVec<Bytes> = MemVec::new()
    var i: usize = 0
    while i < list.count() {
        out.push(Bytes::from_payload(source: list.node(i)))
        i += 1
    }
    DynArray::from_mem_vec(out)
}

fn address_of(_ bytes: [u8; 20]) -> Address {
    var word: u256 = 0
    var i: usize = 0
    while i < 20 {
        word = (word << 8) | bytes[i] as u256
        i += 1
    }
    Address::new(word)
}

fn deploy(mode: u256, key: u64, root: u256, end_slot: u64) -> Address
uses (evm: mut Evm)
{
    let roots = evm
        .create2<MockBeaconRoots>(
            value: Wei::zero(),
            args: (mode, key as u256, root),
            salt: 0,
        )
    evm.create2<BeaconProver>(value: Wei::zero(), args: (roots, end_slot), salt: 0)
}

fn chain_prover() -> Address uses (evm: mut Evm) {
    deploy(
        mode: ANSWER,
        key: c::CHILD_TIMESTAMP,
        root: c::BLOCK_ROOT,
        end_slot: OPEN_END,
    )
}

fn storage_call<const N: usize, const M: usize>(
    prover: Address,
    timestamp: u64,
    _ h: Header,
    state_root: u256,
    account: Address,
    _ account_bytes: [u8; N],
    _ account_offsets: [usize; M],
    account_count: usize,
    storage: NodeList,
    slot: u256,
) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: prover,
        gas: GAS,
        value: Wei::zero(),
        message: ProverMsg::ProveStorage {
            timestamp,
            header: h,
            state_root: Bytes32 { val: state_root },
            state_root_branch: words(c::PAYLOAD_STATE_ROOT_BRANCH),
            account,
            account_nodes: abi_nodes(
                NodeList::from_fixture(
                    account_bytes,
                    account_offsets,
                    first: 0,
                    count: account_count,
                ),
            ),
            slot,
            storage_nodes: abi_nodes(storage),
        },
    )
}

fn usdc_call(
    prover: Address,
    timestamp: u64,
    _ h: Header,
    state_root: u256,
    account: Address,
) -> CallOutcome
uses (evm: mut Evm)
{
    storage_call(
        prover,
        timestamp,
        h,
        state_root,
        account,
        usdc::ACCOUNT_BYTES,
        usdc::ACCOUNT_OFFSETS,
        account_count: usdc::ACCOUNT_NODE_COUNT,
        storage: NodeList::from_fixture(
            usdc::SLOT_BYTES,
            usdc::SLOT_OFFSETS,
            first: 0,
            count: usdc::SLOT_NODE_STARTS[1] - usdc::SLOT_NODE_STARTS[0],
        ),
        slot: usdc::SLOT_KEYS[0],
    )
}

fn weth_call(prover: Address, slot: usize, key: u256) -> CallOutcome
uses (evm: mut Evm)
{
    storage_call(
        prover,
        timestamp: c::CHILD_TIMESTAMP,
        header(),
        state_root: c::PAYLOAD_STATE_ROOT_LEAF,
        account: address_of(weth::ADDRESS_BYTES),
        weth::ACCOUNT_BYTES,
        weth::ACCOUNT_OFFSETS,
        account_count: weth::ACCOUNT_NODE_COUNT,
        storage: NodeList::from_fixture(
            weth::SLOT_BYTES,
            weth::SLOT_OFFSETS,
            first: weth::SLOT_NODE_STARTS[slot],
            count: weth::SLOT_NODE_STARTS[slot + 1] - weth::SLOT_NODE_STARTS[slot],
        ),
        slot: key,
    )
}

fn returned(_ outcome: CallOutcome) -> (u256, u64) {
    core::assert(outcome.success())
    let data = outcome.returndata()
    core::assert(data.len() == 64)
    (data.read_word(0), data.read_word(32).downcast_truncate())
}

fn proof_failure(_ outcome: CallOutcome) -> u256 {
    core::assert(!outcome.success())
    core::assert(is_error<InvalidProof>(outcome.returndata()))
    outcome.returndata().read_word(4)
}

fn root_unavailable(_ outcome: CallOutcome, timestamp: u64) -> bool {
    !outcome.success()
        && is_error<RootUnavailable>(outcome.returndata())
        && outcome.returndata().read_word(4) == timestamp as u256
}

#[cfg(target = "evm")]
#[test]
fn storage_slots_are_proven_through_the_contract_from_the_4788_root()
uses (evm: mut Evm)
{
    let prover = chain_prover()
    let (value, slot) = returned(
        usdc_call(
            prover,
            timestamp: c::CHILD_TIMESTAMP,
            header(),
            state_root: c::PAYLOAD_STATE_ROOT_LEAF,
            account: address_of(usdc::ADDRESS_BYTES),
        ),
    )
    core::assert(value == usdc::SLOT_VALUES[0])
    core::assert(slot == c::SLOT)
    var i: usize = 0
    while i < 3 {
        let (weth_value, weth_slot) = returned(weth_call(prover, slot: i, key: weth::SLOT_KEYS[i]))
        core::assert(weth_value == weth::SLOT_VALUES[i])
        core::assert(weth_slot == c::SLOT)
        i += 1
    }
}

#[cfg(target = "evm")]
#[test]
fn a_storage_proof_answers_only_for_its_own_slot_and_account()
uses (evm: mut Evm)
{
    let prover = chain_prover()
    core::assert(
        proof_failure(weth_call(prover, slot: 1, key: weth::SLOT_KEYS[0])) == HASH_MISMATCH_CODE,
    )
    let usdc_address = address_of(usdc::ADDRESS_BYTES)
    let wrong = Address::new(usdc_address.word() ^ 1)
    core::assert(
        proof_failure(
                usdc_call(
                    prover,
                    timestamp: c::CHILD_TIMESTAMP,
                    header(),
                    state_root: c::PAYLOAD_STATE_ROOT_LEAF,
                    account: wrong,
                ),
            )
            == HASH_MISMATCH_CODE,
    )
    core::assert(
        proof_failure(
                usdc_call(
                    prover,
                    timestamp: c::CHILD_TIMESTAMP,
                    header(),
                    state_root: c::PAYLOAD_STATE_ROOT_LEAF,
                    account: address_of(weth::ADDRESS_BYTES),
                ),
            )
            == HASH_MISMATCH_CODE,
    )
}

#[cfg(target = "evm")]
#[test]
fn a_state_root_off_the_beacon_branch_is_rejected() uses (evm: mut Evm) {
    let prover = chain_prover()
    let code = proof_failure(
        usdc_call(
            prover,
            timestamp: c::CHILD_TIMESTAMP,
            header(),
            state_root: c::PAYLOAD_STATE_ROOT_LEAF ^ 1,
            account: address_of(usdc::ADDRESS_BYTES),
        ),
    )
    core::assert(code == ROOT_MISMATCH_CODE)
}

#[cfg(target = "evm")]
#[test]
fn every_header_field_is_bound_to_the_4788_root() uses (evm: mut Evm) {
    let prover = chain_prover()
    var field: usize = 0
    while field < 5 {
        var h = header()
        if field == 0 {
            h.slot += 1
        } else if field == 1 {
            h.proposer_index += 1
        } else if field == 2 {
            h.parent_root = Bytes32 { val: h.parent_root.val ^ 1 }
        } else if field == 3 {
            h.state_root = Bytes32 { val: h.state_root.val ^ 1 }
        } else {
            h.body_root = Bytes32 { val: h.body_root.val ^ 1 }
        }
        let outcome = usdc_call(
            prover,
            timestamp: c::CHILD_TIMESTAMP,
            h,
            state_root: c::PAYLOAD_STATE_ROOT_LEAF,
            account: address_of(usdc::ADDRESS_BYTES),
        )
        core::assert(!outcome.success())
        core::assert(is_error<HeaderMismatch>(outcome.returndata()))
        core::assert(outcome.returndata().read_word(4) == c::BLOCK_ROOT)
        field += 1
    }
}

#[cfg(target = "evm")]
#[test]
fn a_root_is_trusted_only_from_an_exact_32_byte_answer() uses (evm: mut Evm) {
    let account = address_of(usdc::ADDRESS_BYTES)
    let prover = chain_prover()
    core::assert(
        root_unavailable(
            usdc_call(
                prover,
                timestamp: c::CHILD_TIMESTAMP + 12,
                header(),
                state_root: c::PAYLOAD_STATE_ROOT_LEAF,
                account,
            ),
            timestamp: c::CHILD_TIMESTAMP + 12,
        ),
    )
    var mode: u256 = REVERT
    while mode <= EMPTY {
        let misbehaving = deploy(
            mode,
            key: c::CHILD_TIMESTAMP,
            root: c::BLOCK_ROOT,
            end_slot: OPEN_END,
        )
        core::assert(
            root_unavailable(
                usdc_call(
                    prover: misbehaving,
                    timestamp: c::CHILD_TIMESTAMP,
                    header(),
                    state_root: c::PAYLOAD_STATE_ROOT_LEAF,
                    account,
                ),
                timestamp: c::CHILD_TIMESTAMP,
            ),
        )
        mode += 1
    }
}

fn at_slot(_ slot: u64) -> Header {
    var h = header()
    h.slot = slot
    h
}

fn fork_outcome(slot: u64, end_slot: u64) -> CallOutcome uses (evm: mut Evm) {
    let h = at_slot(slot)
    let prover = deploy(
        mode: ANSWER,
        key: c::CHILD_TIMESTAMP,
        root: root_of(h),
        end_slot,
    )
    usdc_call(
        prover,
        timestamp: c::CHILD_TIMESTAMP,
        h,
        state_root: c::PAYLOAD_STATE_ROOT_LEAF,
        account: address_of(usdc::ADDRESS_BYTES),
    )
}

fn unsupported(_ outcome: CallOutcome, slot: u64) -> bool {
    !outcome.success()
        && is_error<UnsupportedSlot>(outcome.returndata())
        && outcome.returndata().read_word(4) == slot as u256
}

#[cfg(target = "evm")]
#[test]
fn only_headers_from_the_first_fulu_slot_up_to_the_end_slot_are_accepted()
uses (evm: mut Evm)
{
    let end_slot = c::SLOT + 100
    core::assert(
        unsupported(
            fork_outcome(slot: FULU_FIRST_SLOT - 1, end_slot),
            slot: FULU_FIRST_SLOT - 1,
        ),
    )
    core::assert(
        proof_failure(fork_outcome(slot: FULU_FIRST_SLOT, end_slot)) == ROOT_MISMATCH_CODE,
    )
    core::assert(
        proof_failure(fork_outcome(slot: end_slot - 1, end_slot)) == ROOT_MISMATCH_CODE,
    )
    core::assert(
        unsupported(fork_outcome(slot: end_slot, end_slot), slot: end_slot),
    )
    let prover = deploy(
        mode: ANSWER,
        key: c::CHILD_TIMESTAMP,
        root: c::BLOCK_ROOT,
        end_slot: c::SLOT,
    )
    core::assert(
        unsupported(
            usdc_call(
                prover,
                timestamp: c::CHILD_TIMESTAMP,
                header(),
                state_root: c::PAYLOAD_STATE_ROOT_LEAF,
                account: address_of(usdc::ADDRESS_BYTES),
            ),
            slot: c::SLOT,
        ),
    )
}

