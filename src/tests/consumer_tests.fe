#[test]
fn proof_error_codes_are_a_fixed_public_table() {
    core::assert(proof_error_code(ProofError::BadRlp) == 1)
    core::assert(proof_error_code(ProofError::HashMismatch(0)) == 2)
    core::assert(proof_error_code(ProofError::HashMismatch(7)) == 2)
    core::assert(proof_error_code(ProofError::PathExhausted) == 3)
    core::assert(proof_error_code(ProofError::TrailingNodes) == 4)
    core::assert(proof_error_code(ProofError::BadHexPrefix) == 5)
    core::assert(proof_error_code(ProofError::BranchValueOnPath) == 6)
    core::assert(proof_error_code(ProofError::DepthOutOfRange) == 7)
    core::assert(proof_error_code(ProofError::RootMismatch) == 8)
    core::assert(proof_error_code(ProofError::KeyNotConsumed) == 9)
    core::assert(proof_error_code(ProofError::IndexOutOfRange) == 10)
    core::assert(proof_error_code(ProofError::WrongLength) == 11)
}

fn validator_header() -> Header {
    Header {
        slot: v::SLOT,
        proposer_index: v::PROPOSER_INDEX,
        parent_root: Bytes32 { val: v::PARENT_ROOT },
        state_root: Bytes32 { val: v::HEADER_STATE_ROOT },
        body_root: Bytes32 { val: v::BODY_ROOT },
    }
}

fn fixture_record() -> ValidatorRecord {
    ValidatorRecord {
        pubkey: Bytes::from_payload(source: load(v::PUBKEY).span()),
        withdrawal_credentials: Bytes32 { val: v::WITHDRAWAL_CREDENTIALS },
        effective_balance: v::EFFECTIVE_BALANCE,
        slashed: v::SLASHED,
        activation_eligibility_epoch: v::ACTIVATION_ELIGIBILITY_EPOCH,
        activation_epoch: v::ACTIVATION_EPOCH,
        exit_epoch: v::EXIT_EPOCH,
        withdrawable_epoch: v::WITHDRAWABLE_EPOCH,
    }
}

fn slashed_record() -> ValidatorRecord {
    ValidatorRecord {
        pubkey: Bytes::from_payload(source: load(s::PUBKEY).span()),
        withdrawal_credentials: Bytes32 { val: s::WITHDRAWAL_CREDENTIALS },
        effective_balance: s::EFFECTIVE_BALANCE,
        slashed: s::SLASHED,
        activation_eligibility_epoch: s::ACTIVATION_ELIGIBILITY_EPOCH,
        activation_epoch: s::ACTIVATION_EPOCH,
        exit_epoch: s::EXIT_EPOCH,
        withdrawable_epoch: s::WITHDRAWABLE_EPOCH,
    }
}

fn validator_call(prover: Address, index: u64, record: own ValidatorRecord) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: prover,
        gas: GAS,
        value: Wei::zero(),
        message: ProverMsg::ProveValidator {
            timestamp: v::CHILD_TIMESTAMP,
            header: validator_header(),
            index,
            validator: record,
            branch: words(v::VALIDATOR_BRANCH),
        },
    )
}

#[cfg(target = "evm")]
#[test]
fn a_validator_record_is_proven_through_the_contract_with_its_slot()
uses (evm: mut Evm)
{
    let prover = deploy(
        mode: ANSWER,
        key: v::CHILD_TIMESTAMP,
        root: v::BLOCK_ROOT,
        end_slot: OPEN_END,
    )
    let outcome = validator_call(
        prover,
        index: v::VALIDATOR_INDEX,
        record: fixture_record(),
    )
    core::assert(outcome.success())
    core::assert(outcome.returndata().len() == 32)
    core::assert(outcome.returndata().read_word(0) == v::SLOT as u256)
    var changed = fixture_record()
    changed.effective_balance = v::EFFECTIVE_BALANCE + 1000000000
    core::assert(
        proof_failure(
                validator_call(prover, index: v::VALIDATOR_INDEX, record: changed),
            )
            == ROOT_MISMATCH_CODE,
    )
    core::assert(
        proof_failure(
                validator_call(prover, index: 1 << 40, record: fixture_record()),
            )
            == INDEX_OUT_OF_RANGE_CODE,
    )
    var short = fixture_record()
    short.pubkey = Bytes::from_payload(source: load(v::PUBKEY).span().slice(offset: 0, len: 47))
    core::assert(
        proof_failure(
                validator_call(prover, index: v::VALIDATOR_INDEX, record: short),
            )
            == WRONG_LENGTH_CODE,
    )
}

#[cfg(target = "evm")]
#[test]
fn a_slashed_validator_record_is_proven_through_the_contract()
uses (evm: mut Evm)
{
    let prover = deploy(
        mode: ANSWER,
        key: s::CHILD_TIMESTAMP,
        root: s::BLOCK_ROOT,
        end_slot: OPEN_END,
    )
    let outcome = evm
        .try_call(
            addr: prover,
            gas: GAS,
            value: Wei::zero(),
            message: ProverMsg::ProveValidator {
                timestamp: s::CHILD_TIMESTAMP,
                header: validator_header(),
                index: s::VALIDATOR_INDEX,
                validator: slashed_record(),
                branch: words(s::VALIDATOR_BRANCH),
            },
        )
    core::assert(outcome.success())
    core::assert(outcome.returndata().read_word(0) == s::SLOT as u256)
}

fn usdc_slot(_ index: usize, drop_last: bool) -> NodeList {
    var nodes = NodeList::from_fixture(
        usdc::SLOT_BYTES,
        usdc::SLOT_OFFSETS,
        first: usdc::SLOT_NODE_STARTS[index],
        count: usdc::SLOT_NODE_STARTS[index + 1] - usdc::SLOT_NODE_STARTS[index],
    )
    if drop_last {
        nodes.drop_last()
    }
    nodes
}

fn usdc_slot_call(prover: Address, index: usize, drop_last: bool) -> CallOutcome
uses (evm: mut Evm)
{
    storage_call(
        prover,
        timestamp: c::CHILD_TIMESTAMP,
        header(),
        state_root: c::PAYLOAD_STATE_ROOT_LEAF,
        account: address_of(usdc::ADDRESS_BYTES),
        usdc::ACCOUNT_BYTES,
        usdc::ACCOUNT_OFFSETS,
        account_count: usdc::ACCOUNT_NODE_COUNT,
        storage: usdc_slot(index, drop_last),
        slot: usdc::SLOT_KEYS[index],
    )
}

fn absent_account_call(prover: Address, account_count: usize, storage: NodeList) -> CallOutcome
uses (evm: mut Evm)
{
    storage_call(
        prover,
        timestamp: c::CHILD_TIMESTAMP,
        header(),
        state_root: c::PAYLOAD_STATE_ROOT_LEAF,
        account: address_of(absent::ADDRESS_BYTES),
        absent::ACCOUNT_BYTES,
        absent::ACCOUNT_OFFSETS,
        account_count,
        storage,
        slot: 0,
    )
}

#[cfg(target = "evm")]
#[test]
fn an_unset_slot_is_proven_zero_and_a_truncated_proof_is_never_read_as_zero()
uses (evm: mut Evm)
{
    let prover = chain_prover()
    core::assert(!usdc::SLOT_PRESENT[1])
    let (value, slot) = returned(usdc_slot_call(prover, index: 1, drop_last: false))
    core::assert(value == 0)
    core::assert(slot == c::SLOT)
    core::assert(
        proof_failure(usdc_slot_call(prover, index: 1, drop_last: true)) == PATH_EXHAUSTED_CODE,
    )
    core::assert(
        proof_failure(usdc_slot_call(prover, index: 0, drop_last: true)) == PATH_EXHAUSTED_CODE,
    )
}

#[cfg(target = "evm")]
#[test]
fn an_absent_account_holds_zero_only_with_no_storage_nodes()
uses (evm: mut Evm)
{
    let prover = chain_prover()
    let (value, slot) = returned(
        absent_account_call(
            prover,
            account_count: absent::ACCOUNT_NODE_COUNT,
            storage: NodeList::new(),
        ),
    )
    core::assert(value == 0)
    core::assert(slot == c::SLOT)
    core::assert(
        proof_failure(
                absent_account_call(
                    prover,
                    account_count: absent::ACCOUNT_NODE_COUNT,
                    storage: usdc_slot(0, drop_last: false),
                ),
            )
            == TRAILING_NODES_CODE,
    )
    core::assert(
        proof_failure(
                absent_account_call(
                    prover,
                    account_count: absent::ACCOUNT_NODE_COUNT - 1,
                    storage: NodeList::new(),
                ),
            )
            == PATH_EXHAUSTED_CODE,
    )
}

fn short_branch<const N: usize>(_ values: [u256; N]) -> DynArray<Bytes32> {
    var out: MemVec<Bytes32> = MemVec::new()
    var i: usize = 0
    while i + 1 < N {
        out.push(Bytes32 { val: values[i] })
        i += 1
    }
    DynArray::from_mem_vec(out)
}

#[cfg(target = "evm")]
#[test]
fn a_timestamp_is_passed_on_with_all_sixty_four_bits() uses (evm: mut Evm) {
    let late: u64 = 0xffffffffffffffff
    let prover = deploy(
        mode: ANSWER,
        key: late,
        root: c::BLOCK_ROOT,
        end_slot: OPEN_END,
    )
    let (value, slot) = returned(
        usdc_call(
            prover,
            timestamp: late,
            header(),
            state_root: c::PAYLOAD_STATE_ROOT_LEAF,
            account: address_of(usdc::ADDRESS_BYTES),
        ),
    )
    core::assert(value == usdc::SLOT_VALUES[0])
    core::assert(slot == c::SLOT)
}

#[cfg(target = "evm")]
#[test]
fn timestamp_zero_never_yields_a_root() uses (evm: mut Evm) {
    let prover = deploy(
        mode: ANSWER,
        key: 0,
        root: c::BLOCK_ROOT,
        end_slot: OPEN_END,
    )
    core::assert(
        root_unavailable(
            usdc_call(
                prover,
                timestamp: 0,
                header(),
                state_root: c::PAYLOAD_STATE_ROOT_LEAF,
                account: address_of(usdc::ADDRESS_BYTES),
            ),
            timestamp: 0,
        ),
    )
}

#[cfg(target = "evm")]
#[test]
fn a_header_is_bound_to_the_root_before_its_slot_is_judged()
uses (evm: mut Evm)
{
    let prover = chain_prover()
    let outcome = usdc_call(
        prover,
        timestamp: c::CHILD_TIMESTAMP,
        at_slot(FULU_FIRST_SLOT - 1),
        state_root: c::PAYLOAD_STATE_ROOT_LEAF,
        account: address_of(usdc::ADDRESS_BYTES),
    )
    core::assert(!outcome.success())
    core::assert(is_error<HeaderMismatch>(outcome.returndata()))
}

#[cfg(target = "evm")]
#[test]
fn a_branch_one_level_short_is_rejected_by_both_messages() uses (evm: mut Evm) {
    let prover = chain_prover()
    let storage = evm
        .try_call(
            addr: prover,
            gas: GAS,
            value: Wei::zero(),
            message: ProverMsg::ProveStorage {
                timestamp: c::CHILD_TIMESTAMP,
                header: header(),
                state_root: Bytes32 { val: c::PAYLOAD_STATE_ROOT_LEAF },
                state_root_branch: short_branch(c::PAYLOAD_STATE_ROOT_BRANCH),
                account: address_of(usdc::ADDRESS_BYTES),
                account_nodes: abi_nodes(
                    NodeList::from_fixture(
                        usdc::ACCOUNT_BYTES,
                        usdc::ACCOUNT_OFFSETS,
                        first: 0,
                        count: usdc::ACCOUNT_NODE_COUNT,
                    ),
                ),
                slot: usdc::SLOT_KEYS[0],
                storage_nodes: abi_nodes(usdc_slot(0, drop_last: false)),
            },
        )
    core::assert(proof_failure(storage) == DEPTH_OUT_OF_RANGE_CODE)
    let validator_prover = deploy(
        mode: ANSWER,
        key: v::CHILD_TIMESTAMP,
        root: v::BLOCK_ROOT,
        end_slot: OPEN_END,
    )
    let record = evm
        .try_call(
            addr: validator_prover,
            gas: GAS,
            value: Wei::zero(),
            message: ProverMsg::ProveValidator {
                timestamp: v::CHILD_TIMESTAMP,
                header: validator_header(),
                index: v::VALIDATOR_INDEX,
                validator: fixture_record(),
                branch: short_branch(v::VALIDATOR_BRANCH),
            },
        )
    core::assert(proof_failure(record) == DEPTH_OUT_OF_RANGE_CODE)
}

#[cfg(target = "evm")]
#[test]
fn a_validator_proof_passes_the_same_root_and_slot_checks()
uses (evm: mut Evm)
{
    let closed = deploy(
        mode: ANSWER,
        key: v::CHILD_TIMESTAMP,
        root: v::BLOCK_ROOT,
        end_slot: v::SLOT,
    )
    core::assert(
        unsupported(
            validator_call(
                prover: closed,
                index: v::VALIDATOR_INDEX,
                record: fixture_record(),
            ),
            slot: v::SLOT,
        ),
    )
    let wrong_root = deploy(
        mode: ANSWER,
        key: v::CHILD_TIMESTAMP,
        root: c::BLOCK_ROOT,
        end_slot: OPEN_END,
    )
    let outcome = validator_call(
        prover: wrong_root,
        index: v::VALIDATOR_INDEX,
        record: fixture_record(),
    )
    core::assert(!outcome.success())
    core::assert(is_error<HeaderMismatch>(outcome.returndata()))
}
