use ingot::fixtures::{
    mainnet_account_absent,
    mainnet_account_eoa,
    mainnet_storage_absent,
    mainnet_storage_usdc,
    mainnet_storage_weth,
}
use ingot::fixture_support::{
    check_account_nodes,
    check_present_account_leaf,
    check_slot_nodes,
    node_at,
    word_bytes,
}
use ingot::{EMPTY_CODE_HASH, EMPTY_STORAGE_ROOT}
use core::hash::keccak256_word

#[test]
fn eoa_fixture_chains_to_its_state_root() {
    core::assert(mainnet_account_eoa::ACCOUNT_PRESENT)
    core::assert(mainnet_account_eoa::STORAGE_ROOT == EMPTY_STORAGE_ROOT)
    let buffer = check_account_nodes(
        mainnet_account_eoa::ACCOUNT_BYTES,
        mainnet_account_eoa::ACCOUNT_OFFSETS,
        node_count: mainnet_account_eoa::ACCOUNT_NODE_COUNT,
        state_root: mainnet_account_eoa::STATE_ROOT,
    )
    check_present_account_leaf(
        buffer,
        mainnet_account_eoa::ACCOUNT_OFFSETS,
        node_count: mainnet_account_eoa::ACCOUNT_NODE_COUNT,
        storage_root: mainnet_account_eoa::STORAGE_ROOT,
        code_hash: mainnet_account_eoa::CODE_HASH,
    )
    check_slot_nodes(
        mainnet_account_eoa::SLOT_BYTES,
        mainnet_account_eoa::SLOT_OFFSETS,
        mainnet_account_eoa::SLOT_NODE_STARTS,
        slot_count: mainnet_account_eoa::SLOT_COUNT,
        storage_root: mainnet_account_eoa::STORAGE_ROOT,
    )
}

#[test]
fn absent_account_fixture_chains_and_carries_defaults() {
    core::assert(!mainnet_account_absent::ACCOUNT_PRESENT)
    core::assert(mainnet_account_absent::NONCE == 0)
    core::assert(mainnet_account_absent::BALANCE == 0)
    core::assert(mainnet_account_absent::STORAGE_ROOT == EMPTY_STORAGE_ROOT)
    core::assert(mainnet_account_absent::CODE_HASH == EMPTY_CODE_HASH)
    let _ = check_account_nodes(
        mainnet_account_absent::ACCOUNT_BYTES,
        mainnet_account_absent::ACCOUNT_OFFSETS,
        node_count: mainnet_account_absent::ACCOUNT_NODE_COUNT,
        state_root: mainnet_account_absent::STATE_ROOT,
    )
}

#[test]
fn absent_slot_fixture_chains_to_the_storage_root() {
    core::assert(mainnet_storage_absent::ACCOUNT_PRESENT)
    core::assert(mainnet_storage_absent::SLOT_COUNT == 1)
    core::assert(!mainnet_storage_absent::SLOT_PRESENT[0])
    core::assert(mainnet_storage_absent::SLOT_VALUES[0] == 0)
    let buffer = check_account_nodes(
        mainnet_storage_absent::ACCOUNT_BYTES,
        mainnet_storage_absent::ACCOUNT_OFFSETS,
        node_count: mainnet_storage_absent::ACCOUNT_NODE_COUNT,
        state_root: mainnet_storage_absent::STATE_ROOT,
    )
    check_present_account_leaf(
        buffer,
        mainnet_storage_absent::ACCOUNT_OFFSETS,
        node_count: mainnet_storage_absent::ACCOUNT_NODE_COUNT,
        storage_root: mainnet_storage_absent::STORAGE_ROOT,
        code_hash: mainnet_storage_absent::CODE_HASH,
    )
    check_slot_nodes(
        mainnet_storage_absent::SLOT_BYTES,
        mainnet_storage_absent::SLOT_OFFSETS,
        mainnet_storage_absent::SLOT_NODE_STARTS,
        slot_count: mainnet_storage_absent::SLOT_COUNT,
        storage_root: mainnet_storage_absent::STORAGE_ROOT,
    )
}

