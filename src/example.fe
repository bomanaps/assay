use core::message::MsgVariant
use std::abi::{Bytes32, DynArray, Sol, SolCompat, sol}
use std::evm::{Address, Call, StorageMap, revert_error}
use ingot::{Header, ProverMsg, ValidatorRecord}

pub const FAR_FUTURE_EPOCH: u64 = 0xffffffffffffffff

#[error]
pub struct NotEligible { pub code: u8 }

pub const INELIGIBLE_SLASHED: u8 = 1
pub const INELIGIBLE_CREDENTIALS: u8 = 2
pub const INELIGIBLE_EXITING: u8 = 3

pub msg GateMsg {
    #[selector = sol(
        "approve(uint64,(uint64,uint64,bytes32,bytes32,bytes32),uint64,(bytes,bytes32,uint64,bool,uint64,uint64,uint64,uint64),bytes32[])",
    )]
    Approve {
        timestamp: u64,
        header: Header,
        index: u64,
        validator: ValidatorRecord,
        branch: DynArray<Bytes32>,
    } -> u64,
    #[selector = sol("approvedSlot(uint64)")]
    ApprovedSlot { index: u64 } -> u64,
}

static_assert(<GateMsg::Approve as MsgVariant<Sol>>::SELECTOR
    == sol(
        (
            "approve",
            <(u64, Header, u64, ValidatorRecord, DynArray<Bytes32>) as SolCompat>::SOL_TYPE,
        ),
    ))

pub contract ValidatorGate uses (call: Call) {
    prover: Address,
    required_credentials: u256,
    mut approvals: StorageMap<u64, u64>,

    init(prover_address: Address, credentials: u256)
    uses (mut prover, mut required_credentials)
    {
        prover = prover_address
        required_credentials = credentials
    }

    recv GateMsg {
        Approve { timestamp, header, index, validator, branch } -> u64
        uses (call, prover, required_credentials, mut approvals)
        {
            if validator.slashed {
                revert_error(NotEligible { code: INELIGIBLE_SLASHED })
            }
            if validator.withdrawal_credentials.val != required_credentials {
                revert_error(NotEligible { code: INELIGIBLE_CREDENTIALS })
            }
            if validator.exit_epoch != FAR_FUTURE_EPOCH {
                revert_error(NotEligible { code: INELIGIBLE_EXITING })
            }
            let slot: u64 = prover
                .static(
                    ProverMsg::ProveValidator { timestamp, header, index, validator, branch },
                )
            approvals[index] = slot
            slot
        }

        ApprovedSlot { index } -> u64 uses (approvals) {
            approvals[index]
        }
    }
}
